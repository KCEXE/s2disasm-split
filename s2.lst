    1621/    140E :                     ; Subroutine to transfer a plane map to VRAM
    1622/    140E :                     ; ---------------------------------------------------------------------------
    1623/    140E :                     
    1624/    140E :                     ; control register:
    1625/    140E :                     ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
    1626/    140E :                     ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
    1627/    140E :                     ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
    1628/    140E :                     ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
    1629/    140E :                     ;
    1630/    140E :                     ;	A00-A15 - address
    1631/    140E :                     ;	CD0-CD3 - code
    1632/    140E :                     ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
    1633/    140E :                     ;	CD5 - DMA operation
    1634/    140E :                     ;
    1635/    140E :                     ;	Bits CD3-CD0:
    1636/    140E :                     ;	0000 - VRAM read
    1637/    140E :                     ;	0001 - VRAM write
    1638/    140E :                     ;	0011 - CRAM write
    1639/    140E :                     ;	0100 - VSRAM read
    1640/    140E :                     ;	0101 - VSRAM write
    1641/    140E :                     ;	1000 - CRAM read
    1642/    140E :                     ;
    1643/    140E :                     ; d0 = control register
    1644/    140E :                     ; d1 = width
    1645/    140E :                     ; d2 = heigth
    1646/    140E :                     ; a1 = source address
    1647/    140E :                     
    1648/    140E :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1649/    140E :                     
    1650/    140E :                     ; sub_140E: ShowVDPGraphics: PlaneMapToVRAM:
    1651/    140E :                     PlaneMapToVRAM_H40:
    1652/    140E : 4DF9 00C0 0000      	lea	(VDP_data_port).l,a6
    1653/    1414 : 283C 0080 0000      	move.l	#vdpCommDelta(planeLoc(64,0,1)),d4	; $800000
    1654/    141A : 2D40 0004           -	move.l	d0,VDP_control_port-VDP_data_port(a6)	; move d0 to VDP_control_port
    1655/    141E : 3601                	move.w	d1,d3
    1656/    1420 : 3C99                -	move.w	(a1)+,(a6)	; from source address to destination in VDP
    1657/    1422 : 51CB FFFC           	dbf	d3,-		; next tile
    1658/    1426 : D084                	add.l	d4,d0		; increase destination address by $80 (1 line)
    1659/    1428 : 51CA FFF0           	dbf	d2,--		; next line
    1660/    142C : 4E75                	rts
    1661/    142E :                     ; End of function PlaneMapToVRAM_H40
