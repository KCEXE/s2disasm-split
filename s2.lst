(1)  879/   3455E :                     ; ----------------------------------------------------------------------------
(1)  880/   3455E :                     ; custom dynamic pattern loading cues for special stage Sonic, Tails and
(1)  881/   3455E :                     ; Tails' tails
(1)  882/   3455E :                     ; The first $12 frames are for Sonic, and the next $12 frames are for Tails.
(1)  883/   3455E :                     ; The last $15 frames are for Tails' tails.
(1)  884/   3455E :                     ; The first $24 frames are almost normal dplcs -- the only difference being
(1)  885/   3455E :                     ; that the art tile to load is pre-shifted left by 4 bits.
(1)  886/   3455E :                     ; The same applies to the last $15 frames, but they have yet another difference:
(1)  887/   3455E :                     ; a small space optimization. These frames only have one dplc per frame ever,
(1)  888/   3455E :                     ; hence the two-byte dplc count is removed from each frame.
(1)  889/   3455E :                     ; ----------------------------------------------------------------------------
(1)  890/   3455E :                     	pushv ,SonicDplcVer	; Backup previous value of SonicDplcVer
(1)  891/   3455E : =$4                  SonicDplcVer := 4		; Switch to custom DPLC format
(1)  892/   3455E :                     
