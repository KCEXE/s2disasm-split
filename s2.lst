   19451/   16394 : 48C0                	ext.l	d0
   19452/   16396 : E180                	asl.l	#8,d0	; shift velocity to line up with the middle 16 bits of the 32-bit position
   19453/   16398 : D480                	add.l	d0,d2	; add x speed to x position	; note this affects the subpixel position x_sub(a0) = 2+x_pos(a0)
   19454/   1639A : 3028 0012           	move.w	y_vel(a0),d0	; load y speed
   19455/   1639E : 0668 0038 0012      	addi.w	#$38,y_vel(a0)	; increase vertical speed (apply gravity)
   19456/   163A4 : 48C0                	ext.l	d0
   19457/   163A6 : E180                	asl.l	#8,d0	; shift velocity to line up with the middle 16 bits of the 32-bit position
   19458/   163A8 : D680                	add.l	d0,d3	; add old y speed to y position	; note this affects the subpixel position y_sub(a0) = 2+y_pos(a0)
   19459/   163AA : 2142 0008           	move.l	d2,x_pos(a0)	; store new x position
   19460/   163AE : 2143 000C           	move.l	d3,y_pos(a0)	; store new y position
   19461/   163B2 : 4E75                	rts
   19462/   163B4 :                     ; End of function ObjectMoveAndFall
