   20121/   19A6C :                     
   20122/   19A6C :                     .isAbove:
   20123/   19A6C :                     	; Now...
   20124/   19A6C :                     	; 'd0' contains Sonic's distance to the nearest object horizontal edge.
   20125/   19A6C :                     	; 'd5' contains the absolute version of 'd0'.
   20126/   19A6C :                     	; 'd3' contains Sonic's distance to the nearest object vertical edge.
   20127/   19A6C :                     	; 'd1' contains the absolute version of 'd3'.
   20128/   19A6C : BA41                	cmp.w	d1,d5
   20129/   19A6E : 6200 0086           	bhi.w	SolidObject_TopBottom		; Branch, if horizontal distance is greater than vertical distance.
   20130/   19A72 :                     ; loc_19A6A:
   20131/   19A72 :                     SolidObject_LeftRight:
   20132/   19A72 :                     	; If Sonic is extremely close to the top or bottom, then branch.
   20133/   19A72 :                     	; I guess the point of this is to let Sonic walk over objects that
   20134/   19A72 :                     	; are barely poking out of the ground?
