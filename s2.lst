   14296/    C526 :                     SwScrl_Title:
   14297/    C526 :                     	; Update the background's vertical scrolling.
   14298/    C526 : 31F8 EE0C F618      	move.w	(Camera_BG_Y_pos).w,(Vscroll_Factor_BG).w
   14299/    C52C :                     
   14300/    C52C :                     	; Automatically scroll the background.
   14301/    C52C : 5278 EE00           	addq.w	#1,(Camera_X_pos).w
   14302/    C530 :                     
   14303/    C530 :                     	; Calculate the background X position from the foreground X position.
