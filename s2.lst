   21385/   367DE : 6710                	beq.s	AnimChk_Run		; if not, branch
   21386/   367E0 : 1140 001D           	move.b	d0,prev_anim(a0)	; set previous animation to current animation
   21387/   367E4 : 117C 0000 001B      	move.b	#0,anim_frame(a0)	; reset animation
   21388/   367EA : 117C 0000 001E      	move.b	#0,anim_frame_duration(a0)	; reset frame duration
   21389/   367F0 :                     
