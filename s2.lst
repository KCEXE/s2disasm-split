   21219/   366C4 :                     ; Align Child XY
   21220/   366C4 :                     ; Moves a referenced object to the position of the current object with
   21221/   366C4 :                     ; variable x and y offset.
   21222/   366C4 :                     ;
   21223/   366C4 :                     ; input variables:
   21224/   366C4 :                     ;  d0 = x offset
   21225/   366C4 :                     ;  d1 = y offset
   21226/   366C4 :                     ;
   21227/   366C4 :                     ;  a0 = parent object
   21228/   366C4 :                     ;  a1 = child object
   21229/   366C4 :                     ;
   21230/   366C4 :                     ; writes:
   21231/   366C4 :                     ;  d2 = new x position
   21232/   366C4 :                     ;  d3 = new y position
   21233/   366C4 :                     ; ---------------------------------------------------------------------------
   21234/   366C4 :                     ;loc_36760:
