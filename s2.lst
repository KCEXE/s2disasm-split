   21330/   3677E :                     ;  d0
   21331/   3677E :                     ;  d1 = index in list
   21332/   3677E :                     ;  d6 = num objects
   21333/   3677E :                     ;
   21334/   3677E :                     ;  a1 = addres of new projectile
   21335/   3677E :                     ;  a3 = movement type (ObjectMove)
