   18713/    E13E :                     	; tiles twice as tall (16x8 instead of 8x8). Because of this, blocks
   18714/    E13E :                     	; are now composed of only two tiles, arranged side by side.
   18715/    E13E : 0810 0003           	btst	#3,(a0)
