(1)  300/   3FEE8 :                     ; ===========================================================================
(1)  301/   3FEE8 :                     ; ZONE ANIMATION SCRIPTS
(1)  302/   3FEE8 :                     ;
(1)  303/   3FEE8 :                     ; The Dynamic_Normal subroutine uses these scripts to reload certain tiles,
(1)  304/   3FEE8 :                     ; thus animating them. All the relevant art must be uncompressed, because
(1)  305/   3FEE8 :                     ; otherwise the subroutine would spend so much time waiting for the art to be
(1)  306/   3FEE8 :                     ; decompressed that the VBLANK window would close before all the animating was done.
(1)  307/   3FEE8 :                     
(1)  308/   3FEE8 :                     ;    zoneanimdecl -1, ArtUnc_Flowers1, ArtTile_ArtUnc_Flowers1, 6, 2
(1)  309/   3FEE8 :                     ;	-1			Global frame duration. If -1, then each frame will use its own duration, instead
(1)  310/   3FEE8 :                     ;	ArtUnc_Flowers1		Source address
(1)  311/   3FEE8 :                     ;	ArtTile_ArtUnc_Flowers1	Destination VRAM address
(1)  312/   3FEE8 :                     ;	6			Number of frames
(1)  313/   3FEE8 :                     ;	2			Number of tiles to load into VRAM for each frame
(1)  314/   3FEE8 :                     
(1)  315/   3FEE8 :                     ;    dc.b   0,$7F		; Start of the script proper
(1)  316/   3FEE8 :                     ;	0			Tile ID of first tile in ArtUnc_Flowers1 to transfer
(1)  317/   3FEE8 :                     ;	$7F			Frame duration. Only here if global duration is -1
(1)  318/   3FEE8 :                     
(1)  319/   3FEE8 :                     ; loc_3FF94:
(1)  320/   3FEE8 : (MACRO)              Animated_EHZ:	zoneanimstart
(1)  320/   3FEE8 : =$3FEE8              Animated_EHZ label *
