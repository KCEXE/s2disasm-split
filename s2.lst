   13538/    B564 :                     
   13539/    B564 :                      ; temporarily remap characters to credit text format
   13540/    B564 :                      ; let's encode 2-wide characters like Aa, Bb, Cc, etc. and hide it with a macro
   13541/    B564 :                      charset '@',"\x3B\2\4\6\8\xA\xC\xE\x10\x12\x13\x15\x17\x19\x1B\x1D\x1F\x21\x23\x25\x27\x29\x2B\x2D\x2F\x31\x33"
   13542/    B564 :                      charset 'a',"\3\5\7\9\xB\xD\xF\x11\x12\x14\x16\x18\x1A\x1C\x1E\x20\x22\x24\x26\x28\x2A\x2C\x2E\x30\x32\x34"
   13543/    B564 :                      charset '!',"\x3D\x39\x3F\x36"
   13544/    B564 :                      charset '\H',"\x39\x37\x38"
   13545/    B564 :                      charset '9',"\x3E\x40\x41"
   13546/    B564 :                      charset '1',"\x3C\x35"
   13547/    B564 :                      charset '.',"\x3A"
   13548/    B564 :                      charset ' ',0
   13549/    B564 :                     
   13550/    B564 :                      ; macro for defining credit text in conjunction with the remapped character set
   13551/    B564 : =$1                  vram_src := ArtTile_ArtNem_CreditText_CredScr
   13552/    B564 :                     creditText macro pal,ss
   13553/    B564 :                     	if ((vram_src & $FF) <> $0) && ((vram_src & $FF) <> $1)
   13554/    B564 :                     		fatal "The low byte of vram_src was $\{vram_src & $FF}, but it must be $00 or $01."
   13555/    B564 :                     	endif
   13556/    B564 :                     	dc.b (make_art_tile(vram_src,pal,0) & $FF00) >> 8
   13557/    B564 :                     	irpc char,ss
   13558/    B564 :                     	dc.b "char"
   13559/    B564 :                     	switch "char"
   13560/    B564 :                     	case "I"
   13561/    B564 :                     	case "1"
   13562/    B564 :                     		dc.b "!"
   13563/    B564 :                     	case "2"
   13564/    B564 :                     		dc.b "$"
   13565/    B564 :                     	case "9"
   13566/    B564 :                     		dc.b "#"
   13567/    B564 :                     	elsecase
   13568/    B564 :                     l := lowstring("char")
   13569/    B564 :                     		if l<>"char"
   13570/    B564 :                     			dc.b l
   13571/    B564 :                     		endif
   13572/    B564 :                     	endcase
   13573/    B564 :                     	endm
   13574/    B564 :                     	dc.b -1
   13575/    B564 :                     	rev02even
   13576/    B564 :                         endm
   13577/    B564 :                     
   13578/    B564 :                     ; credits text data (palette index followed by a string)
   13579/    B564 : =$1                  vram_src := ArtTile_ArtNem_CreditText_CredScr
