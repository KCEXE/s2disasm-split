   21583/   425B4 :                     
   21584/   425B4 :                     	include "_inc/Pattern Loading Requests.asm"
(1)    1/   425B4 :                     ; ---------------------------------------------------------------------------
(1)    2/   425B4 :                     ; PATTERN LOAD REQUEST LISTS
(1)    3/   425B4 :                     ;
(1)    4/   425B4 :                     ; Pattern load request lists are simple structures used to load
(1)    5/   425B4 :                     ; Nemesis-compressed art for sprites.
(1)    6/   425B4 :                     ;
(1)    7/   425B4 :                     ; The decompressor predictably moves down the list, so request 0 is processed first, etc.
(1)    8/   425B4 :                     ; This only matters if your addresses are bad and you overwrite art loaded in a previous request.
(1)    9/   425B4 :                     ;
(1)   10/   425B4 :                     
(1)   11/   425B4 :                     ; NOTICE: The load queue buffer can only hold $10 (16) load requests. None of the routines
(1)   12/   425B4 :                     ; that load PLRs into the queue do any bounds checking, so it's possible to create a buffer
(1)   13/   425B4 :                     ; overflow and completely screw up the variables stored directly after the queue buffer.
(1)   14/   425B4 :                     ; (in my experience this is a guaranteed crash or hang)
(1)   15/   425B4 :                     ;
(1)   16/   425B4 :                     ; Many levels queue more than 16 items overall,
(1)   17/   425B4 :                     ; but they don't exceed the limit because
(1)   18/   425B4 :                     ; their PLRs are split into multiple parts (like PlrList_Mtz1 and PlrList_Mtz2)
(1)   19/   425B4 :                     ; and they fully process the first part before requesting the rest.
(1)   20/   425B4 :                     ;
(1)   21/   425B4 :                     ; If you can find some extra RAM for it (which is easy in Sonic 2),
(1)   22/   425B4 :                     ; you can increase this limit by increasing the size of Plc_Buffer.
(1)   23/   425B4 :                     ; ---------------------------------------------------------------------------
(1)   24/   425B4 :                     
(1)   25/   425B4 :                     ;---------------------------------------------------------------------------------------
(1)   26/   425B4 :                     ; Table of pattern load request lists. Remember to use word-length data when adding lists
(1)   27/   425B4 :                     ; otherwise you'll break the array.
(1)   28/   425B4 :                     ;---------------------------------------------------------------------------------------
(1)   29/   425B4 :                     ; word_42660 ; OffInd_PlrLists:
