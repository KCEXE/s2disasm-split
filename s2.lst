   16792/    D510 :                     
   16793/    D510 :                     .screenNotShaking:
   16794/    D510 :                     	; Populate a list of horizontal scroll values for each row.
   16795/    D510 :                     	; The background is broken up into multiple rows of arbitrary
   16796/    D510 :                     	; heights, with each row getting its own scroll value.
   16797/    D510 :                     	; This is used to create an elaborate parallax effect.
   16798/    D510 : 45F8 A800           	lea	(TempArray_LayerDef).w,a2	; Starts at BG scroll row 1
   16799/    D514 : 47EA 0006           	lea	3*2(a2),a3			; Starts at BG scroll row 4
   16800/    D518 :                     
   16801/    D518 :                     	; Set up the speed of each row (there are 16 rows in total)
   16802/    D518 : 3038 EE00           	move.w	(Camera_X_pos).w,d0
   16803/    D51C : 48C0                	ext.l	d0
   16804/    D51E : E980                	asl.l	#4,d0
   16805/    D520 : 81FC 000A           	divs.w	#10,d0
   16806/    D524 : 48C0                	ext.l	d0
   16807/    D526 : E980                	asl.l	#4,d0
   16808/    D528 : E180                	asl.l	#8,d0
   16809/    D52A : 2200                	move.l	d0,d1
   16810/    D52C :                     
   16811/    D52C :                     	; Set row 4's speed
   16812/    D52C : 4841                	swap	d1
   16813/    D52E : 36C1                	move.w	d1,(a3)+	; Top row of background moves 10 times slower than foreground
   16814/    D530 : 4841                	swap	d1
   16815/    D532 : D281                	add.l	d1,d1
   16816/    D534 : D280                	add.l	d0,d1
   16817/    D536 :                     	; Set rows 5-10's speed
   16818/    D536 :                         rept 6
   16819/    D536 :                     	swap	d1
   16820/    D536 :                     	move.w	d1,(a3)+	; Next row moves 3 times faster than top row, then next row is 4 times faster, then 5, etc.
   16821/    D536 :                     	swap	d1
   16822/    D536 :                     	add.l	d0,d1
   16823/    D536 :                         endm
   16819/    D536 : 4841                	swap	d1
   16820/    D538 : 36C1                	move.w	d1,(a3)+	; Next row moves 3 times faster than top row, then next row is 4 times faster, then 5, etc.
   16821/    D53A : 4841                	swap	d1
   16822/    D53C : D280                	add.l	d0,d1
   16819/    D53E : 4841                	swap	d1
