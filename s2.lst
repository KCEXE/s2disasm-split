(1)  676/   40154 :                     ; Unused mystery function
(1)  677/   40154 :                     ; In CPZ, within a certain range of camera X coordinates spanning
(1)  678/   40154 :                     ; exactly 2 screens (a boss fight or cutscene?),
(1)  679/   40154 :                     ; once every 8 frames, make the entire screen refresh and do... SOMETHING...
(1)  680/   40154 :                     ; (in 2 separate 512-byte blocks of memory, move around a bunch of bytes)
(1)  681/   40154 :                     ; Maybe some abandoned scrolling effect?
(1)  682/   40154 :                     ; ---------------------------------------------------------------------------
(1)  683/   40154 :                     
(1)  684/   40154 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
(1)  685/   40154 :                     
(1)  686/   40154 :                     ; sub_40200:
(1)  687/   40154 : 0C38 000D FE10      	cmpi.b	#chemical_plant_zone,(Current_Zone).w
(1)  688/   4015A : 6702                	beq.s	+
(1)  689/   4015C : 4E75                -	rts
(1)  690/   4015E :                     ; ===========================================================================
(1)  691/   4015E :                     ; this shifts all blocks of the chunks $EA-$ED and $FA-$FD one block to the
(1)  692/   4015E :                     ; left and the last block in each row (chunk $ED/$FD) to the beginning
