    3870/    3384 :                     ; ---------------------------------------------------------------------------
    3871/    3384 :                     ; Subroutine to perform vertical synchronization
    3872/    3384 :                     ; ---------------------------------------------------------------------------
    3873/    3384 :                     
    3874/    3384 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    3875/    3384 :                     
    3876/    3384 :                     ; sub_3384: DelayProgram:
    3877/    3384 :                     WaitForVint:
    3878/    3384 : 46FC 2300           	move	#$2300,sr
    3879/    3388 :                     
    3880/    3388 : 4A38 F62A           -	tst.b	(Vint_routine).w
    3881/    338C : 66FA                	bne.s	-
    3882/    338E : 4E75                	rts
    3883/    3390 :                     ; End of function WaitForVint
    3884/    3390 :                     
    3885/    3390 :                     
    3886/    3390 :                     ; ---------------------------------------------------------------------------
    3887/    3390 :                     ; Subroutine to generate a pseudo-random number in d0
    3888/    3390 :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    3889/    3390 :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    3890/    3390 :                     ; ---------------------------------------------------------------------------
    3891/    3390 :                     
    3892/    3390 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    3893/    3390 :                     
    3894/    3390 :                     ; sub_3390:
    3895/    3390 :                     RandomNumber:
    3896/    3390 : 2238 F636           	move.l	(RNG_seed).w,d1
    3897/    3394 : 6606                	bne.s	+
    3898/    3396 : 223C 2A6D 365A      	move.l	#$2A6D365A,d1 ; if the RNG is 0, reset it to this crazy number
    3899/    339C :                     
    3900/    339C :                     	; set the high word of d0 to be the high word of the RNG
    3901/    339C :                     	; and multiply the RNG by 41
    3902/    339C : 2001                +	move.l	d1,d0
    3903/    339E : E581                	asl.l	#2,d1
    3904/    33A0 : D280                	add.l	d0,d1
    3905/    33A2 : E781                	asl.l	#3,d1
    3906/    33A4 : D280                	add.l	d0,d1
    3907/    33A6 :                     
    3908/    33A6 :                     	; add the low word of the RNG to the high word of the RNG
    3909/    33A6 :                     	; and set the low word of d0 to be the result
    3910/    33A6 : 3001                	move.w	d1,d0
    3911/    33A8 : 4841                	swap	d1
    3912/    33AA : D041                	add.w	d1,d0
    3913/    33AC : 3200                	move.w	d0,d1
    3914/    33AE : 4841                	swap	d1
    3915/    33B0 :                     
    3916/    33B0 : 21C1 F636           	move.l	d1,(RNG_seed).w
    3917/    33B4 : 4E75                	rts
    3918/    33B6 :                     ; End of function RandomNumber
    3919/    33B6 :                     
    3920/    33B6 :                     
    3921/    33B6 :                     ; ---------------------------------------------------------------------------
    3922/    33B6 :                     ; Subroutine to calculate sine and cosine of an angle
    3923/    33B6 :                     ; d0 = input byte = angle (360 degrees == 256)
    3924/    33B6 :                     ; d0 = output word = 255 * sine(angle)
    3925/    33B6 :                     ; d1 = output word = 255 * cosine(angle)
    3926/    33B6 :                     ; ---------------------------------------------------------------------------
    3927/    33B6 :                     
    3928/    33B6 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    3929/    33B6 :                     
    3930/    33B6 :                     ; sub_33B6:
