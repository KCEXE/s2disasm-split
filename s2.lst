   14899/    C998 : 22C0                -	move.l	d0,(a1)+
   14900/    C99A : 51C9 FFFC           	dbf	d1,-
   14901/    C99E :                     
   14902/    C99E :                     	; The remaining lines of code in this function compose the animating clouds.
   14903/    C99E : 2800                	move.l	d0,d4
   14904/    C9A0 : 3038 A822           	move.w	(TempArray_LayerDef+$22).w,d0
   14905/    C9A4 : 5878 A822           	addq.w	#4,(TempArray_LayerDef+$22).w
   14906/    C9A8 :                     
   14907/    C9A8 :                     	; Get delta between camera X and the cloud scroll value.
   14908/    C9A8 : 9440                	sub.w	d0,d2
   14909/    C9AA :                     
   14910/    C9AA :                     	; This big block of code divides and then multiplies the delta by roughly 2.28,
   14911/    C9AA :                     	; effectively subtracting 'delta modulo 2.28' from the delta.
   14912/    C9AA :                     	; I have no idea why this is necessary.
   14913/    C9AA :                     
   14914/    C9AA :                     	; Start by reducing to 44% (100% divided by 2.28)...
   14915/    C9AA : 3002                	move.w	d2,d0
   14920/    C9AC : 3200                	move.w	d0,d1
   14921/    C9AE : E240                	asr.w	#1,d0 ; Divide d0 by 2
   14928/    C9B0 : E841                	asr.w	#4,d1 ; Divide d1 by 16, discarding the remainder
   14930/    C9B2 : 9041                	sub.w	d1,d0 ; 100 / 2 - 100 / 16 = 44
   14931/    C9B4 : 48C0                	ext.l	d0
   14932/    C9B6 :                     	; ...then increase the result to 228%, effectively undoing the reduction to 44% from earlier (0.44 x 2.28 = 1).
   14933/    C9B6 : E180                	asl.l	#8,d0 ; Multiply by 256
   14934/    C9B8 : 81FC 0070           	divs.w	#256*44/100,d0 ; Divide by 112, which is 44% of 256
   14935/    C9BC : 48C0                	ext.l	d0
   14936/    C9BE :                     
   14937/    C9BE :                     	; We are done subtracting 'delta modulo 2.28' from the delta.
   14938/    C9BE :                     
   14939/    C9BE :                     	; Multiply the delta by 256.
   14940/    C9BE : E180                	asl.l	#8,d0
   14941/    C9C0 :                     
   14942/    C9C0 : 45F8 A800           	lea	(TempArray_LayerDef).w,a2	; See 'Dynamic_HTZ.doCloudArt'.
   14943/    C9C4 :                     
   14947/    C9C4 :                     	; d3 is used as a fixed-point accumulator here, with the upper 16 bits
   14948/    C9C4 :                     	; holding the integer part, and the lower 16 bits holding the decimal
   14949/    C9C4 :                     	; part. This accumulator is initialised to the value of the delta
   14950/    C9C4 :                     	; divided by 16, however, the decimal part of this division was not
   14951/    C9C4 :                     	; preserved. This loss of precision causes the clouds to scroll with a
   14952/    C9C4 :                     	; visible jerkiness.
   14953/    C9C4 : 7600                	moveq	#0,d3
   14954/    C9C6 : 3601                	move.w	d1,d3 ; d1 holds the original, pre-modulo delta divided by 16.
   14956/    C9C8 :                     
   14957/    C9C8 :                         rept 3
   14958/    C9C8 :                     	swap	d3
   14959/    C9C8 :                     	add.l	d0,d3
   14960/    C9C8 :                     	swap	d3
   14961/    C9C8 :                     	move.w	d3,(a2)+
   14962/    C9C8 :                         endm
