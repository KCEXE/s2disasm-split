   17140/    D722 : E509                	lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
   17141/    D724 : 5801                	addq.b	#4,d1
   17143/    D726 : 302D 0002           	move.w	Sonic_Pos_Record_Index-Camera_Delay(a5),d0	; get current position buffer index
   17144/    D72A : 9001                	sub.b	d1,d0
   17145/    D72C : 3036 0000           	move.w	(a6,d0.w),d0	; get Sonic's position a certain number of frames ago
   17146/    D730 : 0240 3FFF           	andi.w	#$3FFF,d0
   17147/    D734 : 6004                	bra.s	.checkIfShouldScroll	; use that value for scrolling
   17148/    D736 :                     ; ===========================================================================
   17149/    D736 :                     ; loc_D72E:
   17150/    D736 :                     .scrollNotDelayed:
   17151/    D736 : 3028 0008           	move.w	x_pos(a0),d0
