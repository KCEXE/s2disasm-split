(1)   19/   3FC34 :                     ; ZONE ANIMATION PROCEDURES AND SCRIPTS
(1)   20/   3FC34 :                     ;
(1)   21/   3FC34 :                     ; Each zone gets two entries in this jump table. The first entry points to the
(1)   22/   3FC34 :                     ; zone's animation procedure (usually Dynamic_Normal, but some zones have special
(1)   23/   3FC34 :                     ; procedures for complicated animations). The second points to the zone's animation
(1)   24/   3FC34 :                     ; script.
(1)   25/   3FC34 :                     ;
(1)   26/   3FC34 :                     ; Note that Animated_Null is not a valid animation script, so don't pair it up
(1)   27/   3FC34 :                     ; with anything except Dynamic_Null, or bad things will happen (for example, a bus error exception).
(1)   28/   3FC34 :                     ; ---------------------------------------------------------------------------
(1)   29/   3FC34 : (MACRO)              PLC_DYNANM: zoneOrderedOffsetTable 2,2
(1)   29/   3FC34 :  (MACRO-2)           PLC_DYNANM zoneOrderedTable 2,2
(1)   29/   3FC34 : =$3FC34              PLC_DYNANM label *
(1)   29/   3FC34 :                     ; set some global variables
(1)   29/   3FC34 : ="PLC_DYNANM"        .zone_table_name := "PLC_DYNANM"
(1)   29/   3FC34 : =$3FC34              .zone_table_addr := *
(1)   29/   3FC34 : =$2                  .zone_entry_len := 2
