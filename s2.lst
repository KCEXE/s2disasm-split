   21581/   424E8 :                     
   21582/   424E8 :                     	include "_inc/LevelHeaders.asm"
(1)    1/   424E8 :                     ; ---------------------------------------------------------------------------
(1)    2/   424E8 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   424E8 :                     ;
(1)    4/   424E8 :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   424E8 :                     ; a particular zone. Each zone gets three longwords, in which it stores three
(1)    6/   424E8 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   424E8 :                     ; bits). The assembled data looks something like this:
(1)    8/   424E8 :                     ;
(1)    9/   424E8 :                     ; aaBBBBBB
(1)   10/   424E8 :                     ; ccDDDDDD
(1)   11/   424E8 :                     ; eeFFFFFF
(1)   12/   424E8 :                     ;
(1)   13/   424E8 :                     ; aa = index for primary pattern load request list
(1)   14/   424E8 :                     ; BBBBBB = pointer to level art
(1)   15/   424E8 :                     ; cc = index for secondary pattern load request list
(1)   16/   424E8 :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   17/   424E8 :                     ; ee = index for palette
(1)   18/   424E8 :                     ; FFFFFF = pointer to 128x128 block mappings
(1)   19/   424E8 :                     ;
(1)   20/   424E8 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   21/   424E8 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   22/   424E8 :                     ; collision, object and ring placement arrays (it only points to art...
(1)   23/   424E8 :                     ; although the 128x128 mappings do affect the actual level layout and collision)
(1)   24/   424E8 :                     ; ---------------------------------------------------------------------------
(1)   25/   424E8 :                     
(1)   26/   424E8 :                     ; declare some global variables to be used by the levartptrs macro
