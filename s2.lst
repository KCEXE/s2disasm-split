   23126/   FEA77 :                     ; WARNING the sound driver treats certain sounds specially
   23127/   FEA77 :                     ; going by the ID of the sound.
   23128/   FEA77 :                     ; SndID_Ring, SndID_RingLeft, SndID_Gloop, SndID_SpindashRev
   23129/   FEA77 :                     ; are referenced by the sound driver directly.
   23130/   FEA77 :                     ; If needed you can change this in s2.sounddriver.asm
   23131/   FEA77 :                     
   23132/   FEA77 :                     
   23133/   FEA77 :                     ; NOTE: the exact order of this list determines the priority of each sound, since it determines the sound's SndID.
