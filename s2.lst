    4382/    3C2E :                     	; Find the masking sprite, and move it to the proper location. The
    4383/    3C2E :                     	; sprite is normally at X 128+128, but in order to perform masking,
    4384/    3C2E :                     	; it must be at X 0.
    4385/    3C2E :                     	; The masking sprite is used to stop Sonic and Tails from overlapping
    4386/    3C2E :                     	; the emblem.
    4387/    3C2E :                     	; You might be wondering why it alternates between 0 and 4 for the X
    4388/    3C2E :                     	; position. That's because masking sprites only work if another
    4389/    3C2E :                     	; sprite rendered before them (or if the previous scanline reached
    4390/    3C2E :                     	; its pixel limit). Because of this, a sprite is placed at X 4 before
    4391/    3C2E :                     	; a second one is placed at X 0.
    4392/    3C2E : 43F8 F804           	lea	(Sprite_Table+4).w,a1
    4393/    3C32 : 7000                	moveq	#0,d0
    4394/    3C34 :                     
