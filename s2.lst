   22322/   9E166 :                     ArtKos_HPZ:	;BINCLUDE	"art/kosinski/HPZ.kos"
   22323/   9E166 :                     BM128_HPZ:	;BINCLUDE	"mappings/128x128/HPZ.kos"
   22324/   9E166 :                     
   22325/   9E166 :                     BM16_OOZ:	BINCLUDE	"mappings/16x16/OOZ.kos"
   22326/   9EFFE :                     ArtKos_OOZ:	BINCLUDE	"art/kosinski/OOZ.kos"
   22327/   A15F2 :                     BM128_OOZ:	BINCLUDE	"mappings/128x128/OOZ.kos"
   22328/   A3A9C :                     
