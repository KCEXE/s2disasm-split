   21106/   3663A :                     ; ---------------------------------------------------------------------------
   21107/   3663A :                     ; Get Orientation To Player
   21108/   3663A :                     ; Returns the horizontal and vertical distances of the closest player object.
   21109/   3663A :                     ;
   21110/   3663A :                     ; input variables:
   21111/   3663A :                     ;  a0 = object
   21112/   3663A :                     ;
   21113/   3663A :                     ; returns:
   21114/   3663A :                     ;  a1 = address of closest player character
   21115/   3663A :                     ;  d0 = 0 if player is left from object, 2 if right
   21116/   3663A :                     ;  d1 = 0 if player is above object, 2 if below
   21117/   3663A :                     ;  d2 = closest character's horizontal distance to object
   21118/   3663A :                     ;  d3 = closest character's vertical distance to object
   21119/   3663A :                     ;
   21120/   3663A :                     ; writes:
   21121/   3663A :                     ;  d0, d1, d2, d3, d4, d5
   21122/   3663A :                     ;  a1
   21123/   3663A :                     ;  a2 = sidekick
   21124/   3663A :                     ; ---------------------------------------------------------------------------
   21125/   3663A :                     ;loc_366D6:
   21126/   3663A :                     Obj_GetOrientationToPlayer:
   21127/   3663A : 7000                	moveq	#0,d0
   21128/   3663C : 7200                	moveq	#0,d1
   21129/   3663E : 43F8 B000           	lea	(MainCharacter).w,a1 ; a1=character
   21130/   36642 : 3428 0008           	move.w	x_pos(a0),d2
   21131/   36646 : 9469 0008           	sub.w	x_pos(a1),d2
   21132/   3664A : (MACRO)              	mvabs.w	d2,d4	; absolute horizontal distance to main character
   21132/   3664A : 3802                        move.w  d2,d4
   21132/   3664C : 6A02                        bpl.s   .skip
   21132/   3664E : 4444                        neg.w   d4
   21132/   36650 :                     .skip:
   21133/   36650 : 45F8 B040           	lea	(Sidekick).w,a2 ; a2=character
   21134/   36654 : 3628 0008           	move.w	x_pos(a0),d3
   21135/   36658 : 966A 0008           	sub.w	x_pos(a2),d3
   21136/   3665C : (MACRO)              	mvabs.w	d3,d5	; absolute horizontal distance to sidekick
   21136/   3665C : 3A03                        move.w  d3,d5
   21136/   3665E : 6A02                        bpl.s   .skip
   21136/   36660 : 4445                        neg.w   d5
   21136/   36662 :                     .skip:
   21137/   36662 : B845                	cmp.w	d5,d4	; get shorter distance
   21138/   36664 : 6304                	bls.s	+	; branch, if main character is closer
   21139/   36666 :                     	; if sidekick is closer
   21140/   36666 : 224A                	movea.l	a2,a1
   21141/   36668 : 3403                	move.w	d3,d2
   21142/   3666A :                     +
   21143/   3666A : 4A42                	tst.w	d2	; is player to enemy's left?
   21144/   3666C : 6A02                	bpl.s	+	; if not, branch
   21145/   3666E : 5440                	addq.w	#2,d0
   21146/   36670 :                     +
   21147/   36670 : 3628 000C           	move.w	y_pos(a0),d3
   21148/   36674 : 9669 000C           	sub.w	y_pos(a1),d3	; vertical distance to closest character
   21149/   36678 : 6402                	bhs.s	+	; branch, if enemy is under
   21150/   3667A : 5441                	addq.w	#2,d1
   21151/   3667C :                     +
   21152/   3667C : 4E75                	rts
   21153/   3667E :                     ; ===========================================================================
   21154/   3667E :                     ; ---------------------------------------------------------------------------
   21155/   3667E :                     ; Cap Object Speed
   21156/   3667E :                     ; Prevents an object from going over a specified speed value.
   21157/   3667E :                     ;
   21158/   3667E :                     ; input variables:
   21159/   3667E :                     ;  d0 = max x velocity
   21160/   3667E :                     ;  d1 = max y velocity
   21161/   3667E :                     ;
   21162/   3667E :                     ;  a0 = object
   21163/   3667E :                     ;
   21164/   3667E :                     ; writes:
   21165/   3667E :                     ;  d0, d1, d2, d3
   21166/   3667E :                     ; ---------------------------------------------------------------------------
   21167/   3667E :                     ; loc_3671A:
   21168/   3667E :                     Obj_CapSpeed:
   21169/   3667E : 3428 0010           	move.w	x_vel(a0),d2
   21170/   36682 : 6A0C                	bpl.s	+	; branch, if object is moving right
   21171/   36684 :                     	; going left
   21172/   36684 : 4440                	neg.w	d0	; set opposite direction
   21173/   36686 : B440                	cmp.w	d0,d2	; is object's current x velocity lower than max?
   21174/   36688 : 640C                	bhs.s	++	; if yes, branch
   21175/   3668A : 3400                	move.w	d0,d2	; else, cap speed
   21176/   3668C : 6000 0008           	bra.w	++
   21177/   36690 :                     ; ===========================================================================
   21178/   36690 :                     +	; going right
   21179/   36690 : B440                	cmp.w	d0,d2	; is object's current x velocity lower than max?
   21180/   36692 : 6302                	bls.s	+	; if yes, branch
   21181/   36694 : 3400                	move.w	d0,d2	; else, cap speed
   21182/   36696 :                     +
   21183/   36696 : 3628 0012           	move.w	y_vel(a0),d3
   21184/   3669A : 6A0C                	bpl.s	+	; branch, if object is moving down
   21185/   3669C :                     	; going up
   21186/   3669C : 4441                	neg.w	d1	; set opposite direction
   21187/   3669E : B641                	cmp.w	d1,d3	; is object's current y velocity lower than max?
   21188/   366A0 : 640C                	bhs.s	++	; if yes, branch
   21189/   366A2 : 3601                	move.w	d1,d3	; else, cap speed
   21190/   366A4 : 6000 0008           	bra.w	++
   21191/   366A8 :                     ; ===========================================================================
   21192/   366A8 :                     +	; going down
   21193/   366A8 : B641                	cmp.w	d1,d3	; is object's current y velocity lower than max?
   21194/   366AA : 6302                	bls.s	+	; if yes, branch
   21195/   366AC : 3601                	move.w	d1,d3	; else, cap speed
   21196/   366AE :                     +	; update speed
   21197/   366AE : 3142 0010           	move.w	d2,x_vel(a0)
   21198/   366B2 : 3143 0012           	move.w	d3,y_vel(a0)
   21199/   366B6 : 4E75                	rts
   21200/   366B8 :                     ; ===========================================================================
   21201/   366B8 :                     ; ---------------------------------------------------------------------------
   21202/   366B8 :                     ; Movement Stop
   21203/   366B8 :                     ; Stops an object's movement.
   21204/   366B8 :                     ;
   21205/   366B8 :                     ; input variables:
   21206/   366B8 :                     ;  a0 = object
   21207/   366B8 :                     ;
   21208/   366B8 :                     ; writes:
   21209/   366B8 :                     ;  d0 = 0
   21210/   366B8 :                     ; ---------------------------------------------------------------------------
   21211/   366B8 :                     ;loc_36754:
   21212/   366B8 :                     Obj_MoveStop:
   21213/   366B8 : 7000                	moveq	#0,d0
   21214/   366BA : 3140 0010           	move.w	d0,x_vel(a0)
   21215/   366BE : 3140 0012           	move.w	d0,y_vel(a0)
   21216/   366C2 : 4E75                	rts
