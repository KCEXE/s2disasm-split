   21238/   366CA : 3342 0008           	move.w	d2,x_pos(a1)
   21239/   366CE : 3628 000C           	move.w	y_pos(a0),d3
   21240/   366D2 : D641                	add.w	d1,d3
   21241/   366D4 : 3343 000C           	move.w	d3,y_pos(a1)
   21242/   366D8 : 4E75                	rts
