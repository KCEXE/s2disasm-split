(1) 2707/     BF2 :                     
(1) 2708/     BF2 :                     .continuefade:
(1) 2709/     BF2 : 3A 90 1B            	ld	a,(zAbsVar.FadeInCounter)	; Get current fade out frame count
(1) 2710/     BF5 : B7                  	or	a
(1) 2711/     BF6 : 20 0D               	jr	nz,.fadenotdone			; If fadeout hasn't reached zero yet, skip this
(1) 2712/     BF8 : 3A 98 1B            	ld	a,(zSongDAC.PlaybackControl)	; Get DAC's playback control byte
(1) 2713/     BFB : E6 FB               	and	0FBh				; Clear "SFX is overriding" bit
(1) 2714/     BFD : 32 98 1B            	ld	(zSongDAC.PlaybackControl),a	; Set that
