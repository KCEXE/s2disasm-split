   18196/    DE5E :                     	; Load left column.
   18197/    DE5E : 7AF0                	moveq	#-16,d5 ; X offset
   18198/    DE60 : 1012                	move.b	(a2),d0
   18199/    DE62 : 0200 00A8           	andi.b	#(1<<scroll_flag_advanced_bg1_right)|(1<<scroll_flag_advanced_bg2_right)|(1<<scroll_flag_advanced_bg3_right),d0
   18200/    DE66 : 6708                	beq.s	+
   18201/    DE68 : E208                	lsr.b	#1,d0	; Make the left and right flags share the same bits, to simplify a calculation later.
   18202/    DE6A : 1480                	move.b	d0,(a2)
   18203/    DE6C :                     	; Load right column.
   18204/    DE6C : 3A3C 0140           	move.w	#320,d5 ; X offset
   18205/    DE70 :                     +
   18206/    DE70 :                     	; Select the correct starting background section, and then begin
   18207/    DE70 :                     	; drawing the column.
   18208/    DE70 : (MACRO)              	lea_	CPZ_CameraSections,a0
   18208/    DE70 : 41FA FF66                           !lea CPZ_CameraSections(pc),a0
   18209/    DE74 : 3038 EE0C           	move.w	(Camera_BG_Y_pos).w,d0
   18213/    DE78 :                     	; After right-shifting, the is a mask of $7F. Since CPZ_CameraSections
   18214/    DE78 :                     	; is $40 items long, this is incorrect, and will cause accesses to
   18215/    DE78 :                     	; exceed the bounds of CPZ_CameraSections and read invalid data. This
   18216/    DE78 :                     	; is most notably a problem in Marble Zone's version of this code.
   18217/    DE78 : 0240 07F0           	andi.w	#$7F0,d0
   18219/    DE7C : E848                	lsr.w	#4,d0
   18220/    DE7E : 41F0 0000           	lea	(a0,d0.w),a0
   18221/    DE82 : 6000 000A           	bra.w	DrawBlockColumn_Advanced
