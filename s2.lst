   16861/    D5A8 :                     
   16862/    D5A8 :                     	; Find which row of background is visible at the top of the screen
   16863/    D5A8 :                     .findTopRowLoop:
   16864/    D5A8 : 101B                	move.b	(a3)+,d0	; Get row height
   16865/    D5AA : 544A                	addq.w	#2,a2		; Next row speed (note: is off by 2. This is fixed below)
   16866/    D5AC : 9240                	sub.w	d0,d1
   16867/    D5AE : 64F8                	bcc.s	.findTopRowLoop	; If current row is above the screen, loop and do next row
   16868/    D5B0 :                     
   16869/    D5B0 : 4441                	neg.w	d1		; d1 now contains how many pixels of the row is currently on-screen
   16870/    D5B2 : 554A                	subq.w	#2,a2		; Get correct row speed
   16871/    D5B4 :                     
   16872/    D5B4 : 343C 00DF           	move.w	#224-1,d2 	; Height of screen
   16873/    D5B8 : 3038 EE00           	move.w	(Camera_X_pos).w,d0
   16874/    D5BC : 4440                	neg.w	d0
   16875/    D5BE : 4840                	swap	d0		; Store FG X-pos in upper 16-bits...
   16876/    D5C0 : 301A                	move.w	(a2)+,d0	; ...and BG X-pos in lower 16 bits, as Horiz_Scroll_Buf expects it
   16877/    D5C2 : 4440                	neg.w	d0
   16878/    D5C4 :                     
   16879/    D5C4 : 22C0                -	move.l	d0,(a1)+	; Write 1 FG Horizontal Scroll value, and 1 BG Horizontal Scroll value
   16880/    D5C6 : 5341                	subq.w	#1,d1		; Loop until row at top of screen is done
   16881/    D5C8 : 6606                	bne.s	+
   16882/    D5CA : 121B                	move.b	(a3)+,d1	; Once that row is done, go to next row...
   16883/    D5CC : 301A                	move.w	(a2)+,d0	; ...and use next speed
   16884/    D5CE : 4440                	neg.w	d0
   16885/    D5D0 : 51CA FFF2           +	dbf	d2,-		; Loop until Horiz_Scroll_Buf is full
   16886/    D5D4 :                     
