   21646/   45740 : =$1                  .zone_entries_left := .zone_entries-1
   21646/   45740 : =$3                  .cur_zone_id := .cur_zone_id+1
   21646/   45740 : ="3"                 .cur_zone_str := "\{.cur_zone_id}"
