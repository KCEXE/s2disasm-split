     310/     2CA :                     
     311/     2CA :                     	; Z80 instructions (not the sound driver; that gets loaded later)
     312/     2CA :                     Z80StartupCodeBegin: ; loc_2CA:
     313/     2CA :                         save
     314/     2CA :                         CPU Z80 ; start assembling Z80 code
     315/       0 :                         phase 0 ; pretend we're at address 0
     316/       0 : AF                  	xor	a	; clear a to 0
     317/       1 : 01 D9 1F            	ld	bc,((Z80_RAM_End-Z80_RAM)-zStartupCodeEndLoc)-1 ; prepare to loop this many times
     318/       4 : 11 27 00            	ld	de,zStartupCodeEndLoc+1	; initial destination address
     319/       7 : 21 26 00            	ld	hl,zStartupCodeEndLoc	; initial source address
     320/       A : F9                  	ld	sp,hl	; set the address the stack starts at
     321/       B : 77                  	ld	(hl),a	; set first byte of the stack to 0
     322/       C : ED B0               	ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     323/       E : DD E1               	pop	ix	; clear ix
     324/      10 : FD E1               	pop	iy	; clear iy
     325/      12 : ED 47               	ld	i,a	; clear i
     326/      14 : ED 4F               	ld	r,a	; clear r
     327/      16 : D1                  	pop	de	; clear de
     328/      17 : E1                  	pop	hl	; clear hl
     329/      18 : F1                  	pop	af	; clear af
     330/      19 : 08                  	ex	af,af'	; swap af with af'
     331/      1A : D9                  	exx		; swap bc/de/hl with their shadow registers too
     332/      1B : C1                  	pop	bc	; clear bc
     333/      1C : D1                  	pop	de	; clear de
     334/      1D : E1                  	pop	hl	; clear hl
     335/      1E : F1                  	pop	af	; clear af
     336/      1F : F9                  	ld	sp,hl	; clear sp
     337/      20 : F3                  	di		; clear iff1 (for interrupt handler)
     338/      21 : ED 56               	im	1	; interrupt handling mode = 1
     339/      23 : 36 E9               	ld	(hl),0E9h ; replace the first instruction with a jump to itself
     340/      25 : E9                  	jp	(hl)	  ; jump to the first instruction (to stay there forever)
     341/      26 :                     zStartupCodeEndLoc:
     342/     2F0 :                         dephase ; stop pretending
     343/     2F0 : ALL                  	restore
     344/     2F0 :                         padding off ; unfortunately our flags got reset so we have to set them again...
