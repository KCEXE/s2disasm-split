   21393/   367F6 : D040                	add.w	d0,d0
   21394/   367F8 : D2F1 0000           	adda.w	(a1,d0.w),a1	; calculate address of appropriate animation script
   21395/   367FC : 1151 001E           	move.b	(a1),anim_frame_duration(a0)	; load frame duration
   21396/   36800 : 7200                	moveq	#0,d1
   21397/   36802 : 1228 001B           	move.b	anim_frame(a0),d1	; load current frame number
   21398/   36806 : 1031 1001           	move.b	1(a1,d1.w),d0		; read sprite number from script
   21399/   3680A : 6B0C                	bmi.s	AnimChk_End_FF		; if animation is complete, branch
