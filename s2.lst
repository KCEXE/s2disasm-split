   12867/    977C : D4C0                	adda.w	d0,a2
   12868/    977E : 3038 FF84           	move.w	(Sound_test_sound).w,d0
   12869/    9782 : B012                	cmp.b	(a2),d0
   12870/    9784 : 662C                	bne.s	++
   12871/    9786 : 5278 FFD6           	addq.w	#1,(Correct_cheat_entries_2).w
   12872/    978A : 4A2A 0001           	tst.b	1(a2)
   12873/    978E : 6628                	bne.s	+++	; rts
   12874/    9790 : 4A42                	tst.w	d2				; Test this to determine which cheat to enable
   12875/    9792 : 6610                	bne.s	+				; If not 0, branch
