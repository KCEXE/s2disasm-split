   17006/    D6AA :                     
   17010/    D6AA :                     	; The '+1' is so that, if one block is partially-offscreen at the
   17011/    D6AA :                     	; top, then another will fill the gap at the bottom of the screen.
   17012/    D6AA :                     	; This causes 'Horiz_Scroll_Buf' to overflow due to a lack of
   17013/    D6AA :                     	; bounds-checking. This was likely a deliberate optimisation. Still,
   17014/    D6AA :                     	; it's possible to avoid this without any performance penalty with a
   17015/    D6AA :                     	; little extra code. See below.
   17016/    D6AA : 323C 000E           	move.w	#224/16+1-1,d1
   17018/    D6AE :                     
   17019/    D6AE :                     	; Set up the foreground part of the horizontal scroll value.
   17020/    D6AE : 3038 EE00           	move.w	(Camera_X_pos).w,d0
   17021/    D6B2 : 4440                	neg.w	d0
   17022/    D6B4 : 4840                	swap	d0
   17023/    D6B6 :                     
   17024/    D6B6 : 0242 000F           	andi.w	#$F,d2
   17025/    D6BA :                     
   17048/    D6BA :                     
   17049/    D6BA :                     	; Turn d2 into an offset into '.doPartialLineBlock' (each instruction
   17050/    D6BA :                     	; is 2 bytes long).
   17051/    D6BA : D442                	add.w	d2,d2
   17052/    D6BC :                     	; Get line block scroll value.
   17053/    D6BC : 301A                	move.w	(a2)+,d0
   17054/    D6BE :                     	; Output the first line block.
   17055/    D6BE : 4EFB 2004           	jmp	.doPartialLineBlock(pc,d2.w)
   17056/    D6C2 :                     ; ===========================================================================
   17057/    D6C2 :                     
   17058/    D6C2 :                     .doFullLineBlock:
   17059/    D6C2 :                     	; Get next line block scroll value.
   17060/    D6C2 : 301A                	move.w	(a2)+,d0
   17061/    D6C4 :                     
   17062/    D6C4 :                     	; This works like a Duff's Device.
   17063/    D6C4 :                     .doPartialLineBlock:
   17064/    D6C4 :                         rept 16
   17065/    D6C4 :                     	move.l	d0,(a1)+
   17066/    D6C4 :                         endm
