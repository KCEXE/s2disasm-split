   12850/    974E :                     ; loc_9746:
   12851/    974E :                     CheckCheats:	; This is called from 2 places: the options screen and the level select screen
   12852/    974E : 3038 FFD4           	move.w	(Correct_cheat_entries).w,d0	; Get the number of correct sound IDs entered so far
   12853/    9752 : D0C0                	adda.w	d0,a0				; Skip to the next entry
   12854/    9754 : 3038 FF84           	move.w	(Sound_test_sound).w,d0		; Get the current sound test sound
   12855/    9758 : B010                	cmp.b	(a0),d0				; Compare it to the cheat
   12856/    975A : 6616                	bne.s	+				; If they're different, branch
   12857/    975C : 5278 FFD4           	addq.w	#1,(Correct_cheat_entries).w	; Add 1 to the number of correct entries
   12858/    9760 : 4A28 0001           	tst.b	1(a0)				; Is the next entry 0?
   12859/    9764 : 6612                	bne.s	++				; If not, branch
   12860/    9766 : 32BC 0101           	move.w	#$101,(a1)			; Enable the cheat
   12861/    976A : 103C 00B5           	move.b	#SndID_Ring,d0			; Play the ring sound
   12862/    976E : (MACRO)              	jsrto	PlaySound, JmpTo_PlaySound
