(1) 1945/   3E7F2 :                     ; ===========================================================================
   21567/   3E7F2 :                     
   21568/   3E7F2 :                     	include "_inc/Sprite Upscaling.asm"
(1)    1/   3E7F2 :                     ; ---------------------------------------------------------------------------
(1)    2/   3E7F2 :                     ; Subroutine to upscale graphics by a factor of 2x, based on given mappings
(1)    3/   3E7F2 :                     ; data for correct positioning of tiles.
(1)    4/   3E7F2 :                     ;
(1)    5/   3E7F2 :                     ; This code is awfully structured and planned: whenever a 3-column sprite piece
(1)    6/   3E7F2 :                     ; is scaled, it scales the next tiles that were copied to RAM as if the piece
(1)    7/   3E7F2 :                     ; had 4 columns; this will then be promptly overwritten by the next piece. If
(1)    8/   3E7F2 :                     ; this happens near the end of the buffer, you will get a buffer overrun.
(1)    9/   3E7F2 :                     ; Moreover, when the number of rows in the sprite piece is also 3 or 4, the code
(1)   10/   3E7F2 :                     ; will make an incorrect computation for the output of the next subpiece, which
(1)   11/   3E7F2 :                     ; causes the output to overwrite art from the previous subpiece. Thus, this code
(1)   12/   3E7F2 :                     ; fails if there is a 3x3 or a 3x4 sprite piece in the source mappings. Sadly,
(1)   13/   3E7F2 :                     ; this issue is basically unfixable without rewriting the code entirely.
(1)   14/   3E7F2 :                     ;
(1)   15/   3E7F2 :                     ; Input:
(1)   16/   3E7F2 :                     ; 	a1	Location of tiles to be enlarged
(1)   17/   3E7F2 :                     ; 	a2	Destination buffer for enlarged tiles
(1)   18/   3E7F2 :                     ; 	d0	Width-1 of sprite piece
(1)   19/   3E7F2 :                     ; 	d1	Height-1 of sprite piece
(1)   20/   3E7F2 :                     ; ---------------------------------------------------------------------------
(1)   21/   3E7F2 :                     
(1)   22/   3E7F2 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
(1)   23/   3E7F2 :                     
(1)   24/   3E7F2 :                     ;loc_3E89E
(1)   25/   3E7F2 :                     Scale_2x:
(1)   26/   3E7F2 : 3401                	move.w	d1,d2					; Copy piece height-1
(1)   27/   3E7F4 : 0242 0001           	andi.w	#1,d2					; Want only low bit -- this is 1 for Wx2 or Wx4 pieces, 0 otherwise
(1)   28/   3E7F8 : 5242                	addq.w	#1,d2					; Make it into 2 for Wx2 or Wx4 pieces, 1 otherwise
(1)   29/   3E7FA : ED4A                	lsl.w	#6,d2					; This is now $80 (4 tiles) for Wx2 or Wx4 pieces, $40 (2 tiles) otherwise
(1)   30/   3E7FC : 4842                	swap	d2						; Save it to high word
(1)   31/   3E7FE : 3601                	move.w	d1,d3					; Copy piece height-1 again
(1)   32/   3E800 : E24B                	lsr.w	#1,d3					; This time, want high bit (1 for Wx3 or Wx4, 0 for Wx2 or Wx1)
(1)   33/   3E802 : 5243                	addq.w	#1,d3					; Make it into 2 for Wx3 or Wx4 pieces, 1 otherwise
(1)   34/   3E804 : ED4B                	lsl.w	#6,d3					; This is now $80 (4 tiles) for Wx3 or Wx4 pieces, $40 (2 tiles) otherwise
(1)   35/   3E806 : 4843                	swap	d3						; Save it to high word
(1)   36/   3E808 : 6100 0014           	bsr.w	.upscale_part1				; Scale the first line???; sets a3 = ???, a5 = ???
(1)   37/   3E80C : 0800 0001           	btst	#1,d0					; Is this a 1xH or a 2xH piece?
(1)   38/   3E810 : 6700 919A           	beq.w	return_37A48				; Return if yes
(1)   39/   3E814 : 0801 0001           	btst	#1,d1					; Is this a Wx3 or a Wx4 piece?
(1)   40/   3E818 : 6602                	bne.s	.set_dest				; Branch if yes
(1)   41/   3E81A : 2A4B                	movea.l	a3,a5					; Advance to next column instead
(1)   42/   3E81C :                     
(1)   43/   3E81C :                     .set_dest:
(1)   44/   3E81C : 244D                	movea.l	a5,a2					; Set new output location
(1)   45/   3E81E :                     
(1)   46/   3E81E :                     .upscale_part1:
(1)   47/   3E81E : 284A                	movea.l	a2,a4					; Copy destination to a4
(1)   48/   3E820 : 4842                	swap	d2					; Get height offset
(1)   49/   3E822 : 47F2 2000           	lea	(a2,d2.w),a3				; Output location for next tile
(1)   50/   3E826 : 4842                	swap	d2					; Save height offset again
(1)   51/   3E828 : 3A01                	move.w	d1,d5					; Copy height-1
(1)   52/   3E82A : 0245 0001           	andi.w	#1,d5					; How many tiles we want to do-1 -- this is 1 for Wx2 or Wx4 pieces, 0 otherwise
(1)   53/   3E82E : 6100 0068           	bsr.w	Scale2x_SingleTile
(1)   54/   3E832 : 0801 0001           	btst	#1,d1					; Are we upscaling a Wx3 or Wx4 piece?
(1)   55/   3E836 : 6722                	beq.s	.done_cols				; Branch if not
(1)   56/   3E838 : 4842                	swap	d2					; Get height offset
(1)   57/   3E83A : 3802                	move.w	d2,d4					; Copy it to d4
(1)   58/   3E83C : 4842                	swap	d2					; Save height offset again
(1)   59/   3E83E : D844                	add.w	d4,d4					; This is now $100 (8 tiles) for Wx4 pieces, $80 (4 tiles) for Wx3 pieces
(1)   60/   3E840 : 3600                	move.w	d0,d3					; Copy piece width-1
(1)   61/   3E842 : 0243 0001           	andi.w	#1,d3					; Want only low bit -- this is 1 for 2xH or 4xH pieces, 0 otherwise
(1)   62/   3E846 : E76C                	lsl.w	d3,d4					; This is now: $200 (16 tiles) for 2x4 or 4x4 pieces; $100 (8 tiles) for 2x3, 4x3, 1x4 or 3x4 pieces; $80 (4 tiles) for 1x3 or 3x3 pieces
(1)   63/   3E848 : D8C4                	adda.w	d4,a4					; Advance to this location
(1)   64/   3E84A : 3A01                	move.w	d1,d5					; Copy height-1
(1)   65/   3E84C : E24D                	lsr.w	#1,d5					; How many tiles we want to do-1 -- this is 1 for Wx4 pieces, 0 for Wx3 pieces
(1)   66/   3E84E : 4843                	swap	d3					; Get height offset
(1)   67/   3E850 : 4BF4 3000           	lea	(a4,d3.w),a5				; Output location for next tile
(1)   68/   3E854 : 4843                	swap	d3					; Save height offset again
(1)   69/   3E856 : 6100 0058           	bsr.w	Scale2x_SingleTile2
(1)   70/   3E85A :                     
(1)   71/   3E85A :                     .done_cols:
(1)   72/   3E85A : 0800 0000           	btst	#0,d0					; Is this a 1xH or 3xH piece?
(1)   73/   3E85E : 6606                	bne.s	.keep_upscaling				; Branch if not
(1)   74/   3E860 : 0800 0001           	btst	#1,d0					; Was this a single column piece?
(1)   75/   3E864 : 6730                	beq.s	.done					; Return if so
(1)   76/   3E866 :                     
(1)   77/   3E866 :                     .keep_upscaling:
(1)   78/   3E866 : 4842                	swap	d2					; Get height offset
(1)   79/   3E868 : 45F2 2000           	lea	(a2,d2.w),a2				; Output location for next tile
(1)   80/   3E86C : 47F2 2000           	lea	(a2,d2.w),a3				; Output location for next tile
(1)   81/   3E870 : 4842                	swap	d2					; Save height offset again
(1)   82/   3E872 : 3A01                	move.w	d1,d5					; Copy height-1
(1)   83/   3E874 : 0245 0001           	andi.w	#1,d5					; How many tiles we want to do -- this is 1 for Wx2 or Wx4 pieces, 0 otherwise
(1)   84/   3E878 : 6100 001E           	bsr.w	Scale2x_SingleTile
(1)   85/   3E87C : 0801 0001           	btst	#1,d1					; Are we upscaling a Wx3 or Wx4 piece?
(1)   86/   3E880 : 6714                	beq.s	.done					; Branch if not
(1)   87/   3E882 : 3A01                	move.w	d1,d5					; Copy height-1
(1)   88/   3E884 : E24D                	lsr.w	#1,d5					; How many tiles we want to do-1 -- this is 1 for Wx4 or Wx3 pieces, 0 otherwise
(1)   89/   3E886 : 4843                	swap	d3					; Get height offset
(1)   90/   3E888 : 49F4 3000           	lea	(a4,d3.w),a4				; Output location for next tile
(1)   91/   3E88C : 4BF4 3000           	lea	(a4,d3.w),a5				; Output location for next tile
(1)   92/   3E890 : 4843                	swap	d3					; Save height offset again
(1)   93/   3E892 : 6100 001C           	bsr.w	Scale2x_SingleTile2
(1)   94/   3E896 :                     
(1)   95/   3E896 :                     .done:
(1)   96/   3E896 : 4E75                	rts
(1)   97/   3E898 :                     ; ===========================================================================
(1)   98/   3E898 :                     ; Upscales the given tile to the pair of tiles on the output pointers.
