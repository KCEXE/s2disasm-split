   14337/    C578 : 101A                -	move.b	(a2)+,d0
   14338/    C57A : 4880                	ext.w	d0
   14339/    C57C : D043                	add.w	d3,d0
   14340/    C57E : 22C0                	move.l	d0,(a1)+
   14341/    C580 : 51C9 FFF6           	dbf	d1,-
   14342/    C584 :                     
   14343/    C584 :                     	; The remaining 16 lines are not set.
   14344/    C584 :                     
   14345/    C584 : 4E75                	rts
