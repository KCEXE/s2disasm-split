   18144/    DE1A :                     ; loc_DE12:
   18145/    DE1A :                     Draw_BG3_CPZ:
   18146/    DE1A :                     	; This is a lighty-modified duplicate of Scrap Brain Zone's drawing
   18147/    DE1A :                     	; code (which is still in this game - it's labelled 'Draw_BG2_SBZ').
   18148/    DE1A :                     	; This is an advanced form of the usual background-drawing code that
   18149/    DE1A :                     	; allows each row of blocks to update and scroll independently...
   18150/    DE1A :                     	; kind of. There are only three possible 'cameras' that each row can
   18151/    DE1A :                     	; align itself with. Still, each row is free to decide which camera
   18152/    DE1A :                     	; it aligns with.
   18153/    DE1A :                     	; This could have really benefitted Oil Ocean Zone's background,
   18154/    DE1A :                     	; which has a section that goes unseen because the regular background
   18155/    DE1A :                     	; drawer is too primitive to display it without making the sun and
   18156/    DE1A :                     	; clouds disappear. Using this would have avoided that.
   18157/    DE1A :                     	; This code differs from the Scrap Brain Zone version by being
   18158/    DE1A :                     	; hardcoded to a different table ('CPZ_CameraSections' instead of
   18159/    DE1A :                     	; 'SBZ_CameraSections'), and lacking support for redrawing the whole
   18160/    DE1A :                     	; row when it uses "camera 0".
   18161/    DE1A :                     
   18162/    DE1A :                     	; Handle loading the rows as the camera moves up and down.
   18163/    DE1A : 78F0                	moveq	#-16,d4	; Y offset
   18164/    DE1C : 0892 0000           	bclr	#scroll_flag_advanced_bg_up,(a2)
   18165/    DE20 : 660A                	bne.s	.doUpOrDown
   18166/    DE22 : 0892 0001           	bclr	#scroll_flag_advanced_bg_down,(a2)
   18167/    DE26 : 672E                	beq.s	.checkIfShouldDoLeftOrRight
   18168/    DE28 : 383C 00E0           	move.w	#224,d4	; Y offset
   18169/    DE2C :                     
   18170/    DE2C :                     .doUpOrDown:
   18171/    DE2C :                     	; Select the correct camera, so that the X value of the loaded row is
   18172/    DE2C :                     	; right.
   18173/    DE2C : (MACRO)              	lea_	CPZ_CameraSections+1,a0
   18173/    DE2C : 41FA FFAB                           !lea CPZ_CameraSections+1(pc),a0
   18174/    DE30 : 3038 EE0C           	move.w	(Camera_BG_Y_pos).w,d0
   18175/    DE34 : D044                	add.w	d4,d0
   18176/    DE36 : 0240 03F0           	andi.w	#$3F0,d0	; After right-shifting, the is a mask of $3F. Since CPZ_CameraSections is $40 items long, this is correct.
   18177/    DE3A : E848                	lsr.w	#4,d0
   18178/    DE3C : 1030 0000           	move.b	(a0,d0.w),d0
   18179/    DE40 : 367B 0044           	movea.w	BGCameraLookup(pc,d0.w),a3	; Camera, either BG, BG2 or BG3 depending on Y
   18180/    DE44 : 7AF0                	moveq	#-16,d5	; X offset
   18181/    DE46 : 48E7 0C00           	movem.l	d4-d5,-(sp)
   18182/    DE4A : 6100 0442           	bsr.w	CalculateVRAMAddressOfBlockForPlayer1
   18183/    DE4E : 4CDF 0030           	movem.l	(sp)+,d4-d5
   18184/    DE52 : 6100 0146           	bsr.w	DrawBlockRow
   18185/    DE56 :                     
   18186/    DE56 :                     .checkIfShouldDoLeftOrRight:
   18187/    DE56 :                     	; If there are other scroll flags set, then go do them.
   18188/    DE56 : 4A12                	tst.b	(a2)
   18189/    DE58 : 6602                	bne.s	.doLeftOrRight
   18190/    DE5A : 4E75                	rts
   18191/    DE5C :                     ; ===========================================================================
   18192/    DE5C :                     
   18193/    DE5C :                     .doLeftOrRight:
   18194/    DE5C : 78F0                	moveq	#-16,d4 ; Y offset
