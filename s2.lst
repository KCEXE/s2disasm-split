   17923/    DCEE : 04                  	dc.b 4	; 16
   17924/    DCEF : 04                  	dc.b 4	; 17
   17925/    DCF0 : 04                  	dc.b 4	; 18
   17926/    DCF1 : 04                  	dc.b 4	; 19
   17927/    DCF2 : 04                  	dc.b 4	; 20
   17928/    DCF3 : 04                  	dc.b 4	; 21
   17929/    DCF4 :                     	; BG1
   17930/    DCF4 : 02                  	dc.b 2	; 22
   17931/    DCF5 : 02                  	dc.b 2	; 23
