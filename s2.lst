   19267/    E4FC :                     ;ConvertChunksFrom256x256To128x128:
   19268/    E4FC :                     	; This converts Sonic 1-style 256x256 chunks to Sonic 2-style 128x128
   19269/    E4FC :                     	; chunks.
   19270/    E4FC :                     
   19271/    E4FC :                     	; Destination of 128x128 chunks.
   19272/    E4FC : 43F9 00FE 0000      	lea	($FE0000).l,a1
