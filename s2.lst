   19279/    E516 : 6100 008C           	bsr.w	ConvertHalfOf256x256ChunkToTwo128x128Chunks
   19280/    E51A : 51C9 FFF6           	dbf	d1,-
   19281/    E51E :                     
   19282/    E51E : 43F9 00FE 0000      	lea	($FE0000).l,a1
   19283/    E524 : 45F9 00FF 0000      	lea	($FF0000).l,a2
   19284/    E52A :                     
   19285/    E52A :                     	; Insert a blank chunk at the start of chunk table.
   19286/    E52A : 323C 003F           	move.w	#bytesToWcnt(8*8*2),d1
   19287/    E52E : 34FC 0000           -	move.w	#0,(a2)+
   19288/    E532 : 51C9 FFFA           	dbf	d1,-
   19289/    E536 :                     
   19290/    E536 :                     	; Copy the actual chunks to after this blank chunk.
   19291/    E536 : 323C 3FBF           	move.w	#bytesToWcnt($8000-(8*8*2)),d1
   19292/    E53A : 34D9                -	move.w	(a1)+,(a2)+
   19293/    E53C : 51C9 FFFC           	dbf	d1,-
   19294/    E540 :                     
   19295/    E540 : 4E75                	rts
