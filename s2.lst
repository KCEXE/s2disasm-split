   16827/    D56A :                     
   16828/    D56A :                     	; These instructions reveal that ARZ had slightly different scrolling,
   16829/    D56A :                     	; at one point:
   16830/    D56A :                     	; Above the background's mountains is a row of leaves, which is actually
   16831/    D56A :                     	; composed of three separately-scrolling rows. According to this code,
   16832/    D56A :                     	; the first and third rows were meant to scroll at a different speed to the
   16833/    D56A :                     	; second. Possibly due to how bad it looks, the speed values are overwritten
   16834/    D56A :                     	; a few instructions later, so all three move at the same speed.
   16835/    D56A :                     	; This code seems to pre-date the Simon Wai build, which uses the same
   16836/    D56A :                     	; scrolling as the final game.
   16837/    D56A : 3481                	move.w	d1,(a2)		; Set row 1's speed
   16838/    D56C : 3541 0004           	move.w	d1,4(a2)	; Set row 3's speed
   16839/    D570 :                     
   16840/    D570 : 3038 EE08           	move.w	(Camera_BG_X_pos).w,d0
   16841/    D574 : 3540 0002           	move.w	d0,2(a2)	; Set row 2's speed
   16842/    D578 : 3540 0016           	move.w	d0,$16(a2)	; Set row 12's speed
   16843/    D57C : (MACRO)              	_move.w	d0,0(a2)	; Overwrite row 1's speed (now same as row 2's)
   16843/    D57C :  (MACRO-2)                           insn2op move.w, d0,0(a2)
   16843/    D57C : 3540 0001                                   !move.w   d0,1+0(a2)
   16843/    D57F :                                             !org    *-1
   16843/    D57F : 00                                          !dc.b   0
   16844/    D580 : 3540 0004           	move.w	d0,4(a2)	; Overwrite row 3's speed (now same as row 2's)
   16845/    D584 : 3540 0018           	move.w	d0,12*2(a2)	; Set row 13's speed
   16846/    D588 : 3540 001A           	move.w	d0,13*2(a2)	; Set row 14's speed
   16847/    D58C : 3540 001C           	move.w	d0,14*2(a2)	; Set row 15's speed
   16848/    D590 : 3540 001E           	move.w	d0,15*2(a2)	; Set row 16's speed
   16849/    D594 :                     
   16850/    D594 :                     	; Use the list of row scroll values and a list of row heights to fill
   16851/    D594 :                     	; 'Horiz_Scroll_Buf'.
   16852/    D594 : 47F9 0000 D5D6      	lea	(SwScrl_ARZ_RowHeights).l,a3
   16853/    D59A : 45F8 A800           	lea	(TempArray_LayerDef).w,a2
   16854/    D59E : 43F8 E000           	lea	(Horiz_Scroll_Buf).w,a1
