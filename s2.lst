(1) 3298/     E25 :                     
(1) 3299/     E25 :                     	; The following is a crazy block designed to 'multiply' our target voice value by 25...
(1) 3300/     E25 :                     	; Where a single voice is 25 bytes long
(1) 3301/     E25 : 4F                  	ld	c,a	; a -> c
(1) 3302/     E26 : 06 00               	ld	b,0	; b = 0 (so only low byte of 'bc' is set, basically voice to set)
(1) 3303/     E28 : 87                  	add	a,a	; a *= 2 (indexing something...)
(1) 3304/     E29 : 6F                  	ld	l,a	; low byte of 'hl' set to 'a'
(1) 3305/     E2A : 60                  	ld	h,b	; high byte = 0
(1) 3306/     E2B : 29                  	add	hl,hl	; hl *= 2
(1) 3307/     E2C : 29                  	add	hl,hl	; hl *= 2 (total hl * 4!!)
(1) 3308/     E2D : 5D                  	ld	e,l
(1) 3309/     E2E : 54                  	ld	d,h	; de = hl
(1) 3310/     E2F : 29                  	add	hl,hl	; hl *= 2
(1) 3311/     E30 : 19                  	add	hl,de	; hl += de
(1) 3312/     E31 : 09                  	add	hl,bc	; hl += bc (waaah!)
(1) 3313/     E32 : D1                  	pop	de	; old 'hl' value -> 'de'
(1) 3314/     E33 : 19                  	add	hl,de	; hl += de (Adds address from the very beginning)
