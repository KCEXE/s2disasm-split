(1) 3608/     F95 :                     ; ---------------------------------------------------------------------------
(1) 3609/     F95 :                     
(1) 3610/     F95 :                     ; (via Saxman's doc): $F7xxyyzzzz - repeat section of music
(1) 3611/     F95 :                     ;    * xx - loop index, for loops within loops without confusing the engine.
(1) 3612/     F95 :                     ;          o EXAMPLE: Some notes, then a section that is looped twice, then some more notes, and finally the whole thing is looped three times.
(1) 3613/     F95 :                     ;            The "inner" loop (the section that is looped twice) would have an xx of 01, looking something along the lines of F70102zzzz, whereas the "outside" loop (the whole thing loop) would have an xx of 00, looking something like F70003zzzz.
(1) 3614/     F95 :                     ;    * yy - number of times to repeat
(1) 3615/     F95 :                     ;          o NOTE: This includes the initial encounter of the F7 flag, not number of times to repeat AFTER hitting the flag.
(1) 3616/     F95 :                     ;    * zzzz - position to loop back to
(1) 3617/     F95 :                     ; zloc_F95
(1) 3618/     F95 :                     cfRepeatAtPos:
(1) 3619/     F95 :                     					; Loop index is in 'a'
(1) 3620/     F95 : 4E                  	ld	c,(hl)			; Get next byte (number of repeats) -> 'c'
(1) 3621/     F96 : 23                  	inc	hl			; Next byte...
(1) 3622/     F97 : E5                  	push	hl			; Save 'hl'
(1) 3623/     F98 : C6 20               	add	a,zTrack.LoopCounters	; Add to make loop index offset (starts at 20h in track memory)
(1) 3624/     F9A : 6F                  	ld	l,a			; Set hl = offset index
(1) 3625/     F9B : 26 00               	ld	h,0
(1) 3626/     F9D : DD 5D               	ld	e,ixl		; Set 'de' to beginning of track
(1) 3627/     F9F : DD 54               	ld	d,ixu
(1) 3628/     FA1 : 19                  	add	hl,de		; hl is now pointing to track memory offset for this loop
(1) 3629/     FA2 : 7E                  	ld	a,(hl)		; Get loop count at this address
(1) 3630/     FA3 : B7                  	or	a		; Test it
(1) 3631/     FA4 : 20 01               	jr	nz,.loopexists	; If not zero, then skip next step (i.e. we're currently looping)
(1) 3632/     FA6 : 71                  	ld	(hl),c		; Otherwise, set it to the new number of repeats
(1) 3633/     FA7 :                     
(1) 3634/     FA7 :                     .loopexists:
(1) 3635/     FA7 : 35                  	dec	(hl)		; One less loop
(1) 3636/     FA8 : E1                  	pop	hl		; Restore 'hl' (now at the position)
(1) 3637/     FA9 : 28 05               	jr	z,.noloop	; If counted to zero, skip the rest of this (hence start loop count of 1 terminates the loop without ever looping)
(1) 3638/     FAB : 7E                  	ld	a,(hl)		; Get low byte of jump address
(1) 3639/     FAC : 23                  	inc	hl		; Next byte
(1) 3640/     FAD : 66                  	ld	h,(hl)		; Get high byte of jump address -> 'h'
(1) 3641/     FAE : 6F                  	ld	l,a		; Put low byte of jump address -> 'l'
(1) 3642/     FAF :                     
(1) 3643/     FAF :                     	; Note then that this loop command only works AFTER the section you mean to loop
(1) 3644/     FAF : C9                  	ret
(1) 3645/     FB0 :                     
(1) 3646/     FB0 :                     .noloop:
(1) 3647/     FB0 :                     	; If you get here, the loop terminated; just bypass the loop jump address
(1) 3648/     FB0 : 23                  	inc	hl
(1) 3649/     FB1 : 23                  	inc	hl
(1) 3650/     FB2 : C9                  	ret
(1) 3651/     FB3 :                     ; ---------------------------------------------------------------------------
(1) 3652/     FB3 :                     
(1) 3653/     FB3 :                     ; (via Saxman's doc): jump to position yyyy (keep previous position in memory for returning)
(1) 3654/     FB3 :                     ; zloc_FB3
(1) 3655/     FB3 :                     cfJumpToGosub:
(1) 3656/     FB3 : 4F                  	ld	c,a				; a -> c
(1) 3657/     FB4 : DD 7E 0A            	ld	a,(ix+zTrack.StackPointer)	; Get current "stack" offset (starts at 2Ah, i.e. beginning of next track)
(1) 3658/     FB7 : D6 02               	sub	2				; Move back by two (we need to store a new return address)
(1) 3659/     FB9 : DD 77 0A            	ld	(ix+zTrack.StackPointer),a	; Set current stack offset
(1) 3660/     FBC : 46                  	ld	b,(hl)		; Get high byte of jump position -> 'b'
(1) 3661/     FBD : 23                  	inc	hl		; Next byte...
(1) 3662/     FBE : EB                  	ex	de,hl		; hl <=> de
(1) 3663/     FBF : DD 85               	add	a,ixl		; Add low byte of current track pointer to stack offset (low byte of stack location)
(1) 3664/     FC1 : 6F                  	ld	l,a		; Keep this in 'l'
(1) 3665/     FC2 : DD 8C               	adc	a,ixu		; Update high byte, if necessary
(1) 3666/     FC4 : 95                  	sub	l		; Fixup
(1) 3667/     FC5 : 67                  	ld	h,a		; a -> 'h' (Simply, we just did hl = ix + stack_offset)
(1) 3668/     FC6 : 73                  	ld	(hl),e		; Store current address low byte (just after jump) into stack
(1) 3669/     FC7 : 23                  	inc	hl		; Next byte
(1) 3670/     FC8 : 72                  	ld	(hl),d		; Store current address high byte (just after jump) into stack
(1) 3671/     FC9 : 60                  	ld	h,b
(1) 3672/     FCA : 69                  	ld	l,c		; hl = bc (current location is where you wanted to jump to)
(1) 3673/     FCB : C9                  	ret
