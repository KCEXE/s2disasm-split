   10221/    782A :                      ; temporarily remap characters to title card letter format
   10222/    782A :                      ; Characters are encoded as Aa, Bb, Cc, etc. through a macro
   10223/    782A :                      charset 'A',0	; can't have an embedded 0 in a string
   10224/    782A :                      charset 'B',"\4\8\xC\4\x10\x14\x18\x1C\x1E\x22\x26\x2A\4\4\x30\x34\x38\x3C\x40\x44\x48\x4C\x52\x56\4"
   10225/    782A :                      charset 'a',"\4\4\4\4\4\4\4\4\2\4\4\4\6\4\4\4\4\4\4\4\4\4\6\4\4"
   10226/    782A :                      charset '.',"\x5A"
   10227/    782A :                     
   10228/    782A :                     ; letter lookup string
   10229/    782A : ="ABCDEFGHIJKLMN..   llookup	:= "ABCDEFGHIJKLMNOPQRSTUVWXYZ ."
   10230/    782A :                     
   10231/    782A :                     ; macro for defining title card letters in conjunction with the remapped character set
   10232/    782A :                     titleLetters macro letters
   10233/    782A :                          ;  ". ZYXWVUTSRQPONMLKJIHGFEDCBA"
   10234/    782A :                     used := %0110000000000110000000010000	; set to initial state
   10235/    782A :                         irpc char,letters
   10236/    782A :                     	if ~~(used&1<<strstr(llookup,"char"))	; has the letter been used already?
   10237/    782A :                     used := used|1<<strstr(llookup,"char")	; if not, mark it as used
   10238/    782A :                     	dc.b "char"			; output letter code
   10239/    782A :                     	if "char"=="."
   10240/    782A :                     	dc.b 2			; output character size
   10241/    782A :                     	else
   10242/    782A :                     	dc.b lowstring("char")	; output letter size
   10243/    782A :                     	endif
   10244/    782A :                     	endif
   10245/    782A :                         endm
   10246/    782A :                     	dc.w $FFFF	; output string terminator
   10247/    782A :                         endm
   10248/    782A :                     
   10249/    782A :                     ;word_7822:
   10250/    782A :                     SpecialStage_ResultsLetters:
   10251/    782A : (MACRO)              	titleLetters	"ACDGHILMPRSTUW."
   10251/    782A :                          ;  ". ZYXWVUTSRQPONMLKJIHGFEDCBA"
   10251/    782A : =$6006010            used := %0110000000000110000000010000   ; set to initial state
   10251/    782A :                         irpc char,"ACDGHILMPRSTUW."
   10251/    782A :                             if ~~(used&1<<strstr(llookup,"char"))   ; has the letter been used already?
   10251/    782A :                     used := used|1<<strstr(llookup,"char")  ; if not, mark it as used
   10251/    782A :                             dc.b "char"                     ; output letter code
   10251/    782A :                             if "char"=="."
   10251/    782A :                             dc.b 2                  ; output character size
   10251/    782A :                             else
   10251/    782A :                             dc.b lowstring("char")  ; output letter size
   10251/    782A :                             endif
   10251/    782A :                             endif
   10251/    782A :                         endm
   10251/    782A : =$6006011            used := used|1<<strstr(llookup,"A")  ; if not, mark it as used
   10251/    782A : 00                          dc.b "A"                     ; output letter code
   10251/    782B : 04                          dc.b lowstring("A")  ; output letter size
   10251/    782C : =$6006015            used := used|1<<strstr(llookup,"C")  ; if not, mark it as used
