(1)   32/   424E8 :                     	!org LevelArtPointers+zone_id_{cur_zone_str}*12
(1)   33/   424E8 :                     	dc.l (plc1<<24)|art
(1)   34/   424E8 :                     	dc.l (plc2<<24)|map16x16
(1)   35/   424E8 :                     	dc.l (palette<<24)|map128x128
(1)   36/   424E8 :                     cur_zone_id := cur_zone_id+1
(1)   37/   424E8 :                     cur_zone_str := "\{cur_zone_id}"
(1)   38/   424E8 :                         endm
(1)   39/   424E8 :                     
