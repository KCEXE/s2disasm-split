   22774/   E204A :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   22775/   E204A :                     ; Handles the decompression of the sound driver (Saxman compression, an LZSS variant)
   22776/   E204A :                     ; https://segaretro.org/Saxman_compression
   22777/   E204A :                     
   22778/   E204A :                     ; a4 == start of decompressed data (used for dictionary match offsets)
   22779/   E204A :                     ; a5 == current address of end of decompressed data
   22780/   E204A :                     ; a6 == current address in compressed sound driver
   22781/   E204A :                     ; d3 == length of match minus 1
   22782/   E204A :                     ; d4 == offset into decompressed data of dictionary match
   22783/   E204A :                     ; d5 == number of bytes decompressed so far
   22784/   E204A :                     ; d6 == descriptor field
   22785/   E204A :                     ; d7 == bytes left to decompress
   22786/   E204A :                     
   22787/   E204A :                     ; Interestingly, this appears to be a direct translation of the Z80 version in the sound driver
   22788/   E204A :                     ; (or maybe the Z80 version is a direct translation of this...)
   22789/   E204A :                     
   22790/   E204A :                     ; loc_EC04A:
   22791/   E204A :                     DecompressSoundDriver:
   22792/   E204A : 4DFA 009C           	lea	Snd_Driver(pc),a6
   22793/   E204E :                     ; WARNING: the build script needs editing if you rename this label
   22794/   E204E : 3E3C 0F64           movewZ80CompSize:	move.w	#Snd_Driver_End-Snd_Driver,d7 ; patched (by build.lua) after compression since the exact size can't be known beforehand
   22795/   E2052 : 7C00                	moveq	#0,d6	; The decompressor knows it's run out of descriptor bits when it starts reading 0's in bit 8
   22796/   E2054 : 4BF9 00A0 0000      	lea	(Z80_RAM).l,a5
   22797/   E205A : 7A00                	moveq	#0,d5
   22798/   E205C : 49F9 00A0 0000      	lea	(Z80_RAM).l,a4
   22799/   E2062 :                     ; loc_EC062:
   22800/   E2062 :                     SaxDec_Loop:
   22801/   E2062 : E24E                	lsr.w	#1,d6	; Next descriptor bit
   22802/   E2064 : 0806 0008           	btst	#8,d6	; Check if we've run out of bits
   22803/   E2068 : 660A                	bne.s	+	; (lsr 'shifts in' 0's)
   22804/   E206A : 4EBA 0072           	jsr	SaxDec_GetByte(pc)
   22805/   E206E : 1C00                	move.b	d0,d6
   22806/   E2070 : 0046 FF00           	ori.w	#$FF00,d6	; These set bits will disappear from the high byte as the register is shifted
   22807/   E2074 :                     +
   22808/   E2074 : 0806 0000           	btst	#0,d6
   22809/   E2078 : 670C                	beq.s	SaxDec_ReadCompressed
   22810/   E207A :                     
   22811/   E207A :                     ; SaxDec_ReadUncompressed:
   22812/   E207A : 4EBA 0062           	jsr	SaxDec_GetByte(pc)
   22813/   E207E : 1AC0                	move.b	d0,(a5)+
   22814/   E2080 : 5245                	addq.w	#1,d5
   22815/   E2082 : 6000 FFDE           	bra.w	SaxDec_Loop
   22816/   E2086 :                     ; ---------------------------------------------------------------------------
   22817/   E2086 :                     ; loc_EC086:
   22818/   E2086 :                     SaxDec_ReadCompressed:
   22819/   E2086 : 4EBA 0056           	jsr	SaxDec_GetByte(pc)
   22820/   E208A : 7800                	moveq	#0,d4
   22821/   E208C : 1800                	move.b	d0,d4
   22822/   E208E : 4EBA 004E           	jsr	SaxDec_GetByte(pc)
   22823/   E2092 : 1600                	move.b	d0,d3
   22824/   E2094 : 0243 000F           	andi.w	#$F,d3
   22825/   E2098 : 5443                	addq.w	#2,d3	; d3 is the length of the match minus 1
   22826/   E209A : 0240 00F0           	andi.w	#$F0,d0
   22827/   E209E : E948                	lsl.w	#4,d0
   22828/   E20A0 : D840                	add.w	d0,d4
   22829/   E20A2 : 0644 0012           	addi.w	#$12,d4
   22830/   E20A6 : 0244 0FFF           	andi.w	#$FFF,d4	; d4 is the offset into the current $1000-byte window
   22831/   E20AA :                     	; This part is a little tricky. You see, d4 currently contains the low three nibbles of an offset into the decompressed data,
   22832/   E20AA :                     	; where the dictionary match lies. The way the high nibble is decided is first by taking it from d5 - the offset of the end
   22833/   E20AA :                     	; of the decompressed data so far. Then, we see if the resulting offset in d4 is somehow higher than d5.
   22834/   E20AA :                     	; If it is, then it's invalid... *unless* you subtract $1000 from it, in which case it refers to data in the previous $1000 block of bytes.
   22835/   E20AA :                     	; This is all just a really gimmicky way of having an offset with a range of $1000 bytes from the end of the decompressed data.
   22836/   E20AA :                     	; If, however, we cannot subtract $1000 because that would put the pointer before the start of the decompressed data, then
   22837/   E20AA :                     	; this is actually a 'zero-fill' match, which encodes a series of zeroes.
   22838/   E20AA : 3005                	move.w	d5,d0
   22839/   E20AC : 0240 F000           	andi.w	#$F000,d0
   22840/   E20B0 : D840                	add.w	d0,d4
   22841/   E20B2 : BA44                	cmp.w	d4,d5
   22842/   E20B4 : 6416                	bhs.s	SaxDec_IsDictionaryReference
   22843/   E20B6 : 0444 1000           	subi.w	#$1000,d4
   22844/   E20BA : 6410                	bcc.s	SaxDec_IsDictionaryReference
   22845/   E20BC :                     
   22846/   E20BC :                     ; SaxDec_IsSequenceOfZeroes:
   22847/   E20BC : DA43                	add.w	d3,d5
   22848/   E20BE : 5245                	addq.w	#1,d5
   22849/   E20C0 :                     
   22850/   E20C0 : 1AFC 0000           -	move.b	#0,(a5)+
   22851/   E20C4 : 51CB FFFA           	dbf	d3,-
   22852/   E20C8 :                     
   22853/   E20C8 : 6000 FF98           	bra.w	SaxDec_Loop
   22854/   E20CC :                     ; ---------------------------------------------------------------------------
   22855/   E20CC :                     ; loc_EC0CC:
   22856/   E20CC :                     SaxDec_IsDictionaryReference:
   22857/   E20CC : DA43                	add.w	d3,d5
   22858/   E20CE : 5245                	addq.w	#1,d5
   22859/   E20D0 :                     
   22860/   E20D0 : 1AF4 4000           -	move.b	(a4,d4.w),(a5)+
   22861/   E20D4 : 5244                	addq.w	#1,d4
   22862/   E20D6 : 51CB FFF8           	dbf	d3,-
   22863/   E20DA :                     
   22864/   E20DA : 6000 FF86           	bra.w	SaxDec_Loop
   22865/   E20DE :                     ; End of function DecompressSoundDriver
   22866/   E20DE :                     
   22867/   E20DE :                     
   22868/   E20DE :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   22869/   E20DE :                     
   22870/   E20DE :                     ; sub_EC0DE:
   22871/   E20DE :                     SaxDec_GetByte:
   22872/   E20DE : 101E                	move.b	(a6)+,d0
   22873/   E20E0 : 5347                	subq.w	#1,d7	; Decrement remaining number of bytes
