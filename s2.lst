(1)  730/     1B3 :                     zDACDecodeTbl:
(1)  731/     1B3 : 00 01 02 04 08 10   	db	   0,    1,   2,   4,   8,  10h,  20h,  40h
              1B9 : 20 40             
(1)  732/     1BB : 80 FF FE FC F8 F0   	db	 80h,   -1,  -2,  -4,  -8, -10h, -20h, -40h
              1C1 : E0 C0             
(1)  733/     1C3 :                     
(1)  734/     1C3 :                     	; The following two tables are used for when an SFX terminates
(1)  735/     1C3 :                     	; its track to properly restore the music track it temporarily took
(1)  736/     1C3 :                     	; over.  Note that an important rule here is that no SFX may use
(1)  737/     1C3 :                     	; DAC, FM Channel 1, FM Channel 2, or FM Channel 6, period.
(1)  738/     1C3 :                     	; Thus there's also only SFX tracks starting at FM Channel 3.
(1)  739/     1C3 :                     
(1)  740/     1C3 :                     	; The zeroes appear after FM 3 because it calculates the offsets into
(1)  741/     1C3 :                     	; these tables by their channel assignment, where between Channel 3
(1)  742/     1C3 :                     	; and Channel 4 there is a gap numerically.
(1)  743/     1C3 :                     
(1)  744/     1C3 : (MACRO)              	ensure1byteoffset 10h
(1)  745/     1C3 :                     ; zbyte_1C3
(1)  746/     1C3 :                     zMusicTrackOffs:
