   20054/   199F0 :                     ; loc_199E8: SolidObject_cont:
   20055/   199F0 :                     SolidObject_OnScreenTest:
   20056/   199F0 :                     	; If the object is not on-screen, then don't try to collide with it.
   20057/   199F0 :                     	; This is presumably an optimisation, but this means that if Sonic
   20058/   199F0 :                     	; outruns the screen then he can phase through solid objects.
   20059/   199F0 : 4A28 0001           	tst.b	render_flags(a0)
   20060/   199F4 : 6A00 00D6           	bpl.w	SolidObject_TestClearPush
   20061/   199F8 :                     ;loc_199F0:
   20062/   199F8 :                     SolidObject_cont:
   20063/   199F8 :                     	; We now perform the X portion of a bounding box check. To do this, we assume a
   20064/   199F8 :                     	; coordinate system where the X origin is at the object's left edge.
   20065/   199F8 : 3029 0008           	move.w	x_pos(a1),d0			; load Sonic's X position...
   20066/   199FC : 9068 0008           	sub.w	x_pos(a0),d0			; ...and calculate his x position relative to the object.
   20067/   19A00 : D041                	add.w	d1,d0				; Put object's left edge at (0,0).  This is also Sonic's distance to the object's left edge.
   20068/   19A02 : 6B00 00C8           	bmi.w	SolidObject_TestClearPush	; Branch if Sonic is outside the object's left edge.
   20069/   19A06 : 3601                	move.w	d1,d3
   20070/   19A08 : D643                	add.w	d3,d3				; Calculate object's width.
   20071/   19A0A : B043                	cmp.w	d3,d0
   20072/   19A0C : 6200 00BE           	bhi.w	SolidObject_TestClearPush	; Branch if Sonic is outside the object's right edge.
   20073/   19A10 :                     	; We now perform the y portion of a bounding box check. To do this, we assume a
   20074/   19A10 :                     	; coordinate system where the y origin is at the highest y position relative to the object
   20075/   19A10 :                     	; at which Sonic would still collide with it.  This point is
   20076/   19A10 :                     	;   y_pos(object) - width(object)/2 - y_radius(Sonic) - 4,
   20077/   19A10 :                     	; where object is stored in (a0), Sonic in (a1), and height(object)/2 in d2.  This way
   20078/   19A10 :                     	; of doing it causes the object's hitbox to be vertically off-center by -4 pixels.
   20079/   19A10 : 1629 0016           	move.b	y_radius(a1),d3			; load Sonic's Y radius.
   20080/   19A14 : 4883                	ext.w	d3
   20081/   19A16 : D443                	add.w	d3,d2				; Calculate maximum distance for a top collision.
   20082/   19A18 : 3629 000C           	move.w	y_pos(a1),d3			; load Sonic's y position...
   20083/   19A1C : 9668 000C           	sub.w	y_pos(a0),d3			; ...and calculate his y position relative to the object.
   20084/   19A20 : 5843                	addq.w	#4,d3				; Assume a slightly lower position for Sonic.
   20085/   19A22 : D642                	add.w	d2,d3				; Make the highest position where Sonic would still be colliding with the object (0,0).
   20086/   19A24 : 6B00 00A6           	bmi.w	SolidObject_TestClearPush	; Branch if Sonic is above this point.
   20087/   19A28 : 0243 07FF           	andi.w	#$7FF,d3
   20088/   19A2C : 3802                	move.w	d2,d4
   20089/   19A2E : D844                	add.w	d4,d4				; Calculate minimum distance for a bottom collision.
   20090/   19A30 : B644                	cmp.w	d4,d3
   20091/   19A32 : 6400 0098           	bhs.w	SolidObject_TestClearPush	; Branch if Sonic is below this point.
   20092/   19A36 :                     ;loc_19A2E:
   20093/   19A36 :                     SolidObject_ChkBounds:
   20094/   19A36 : 4A29 002A           	tst.b	obj_control(a1)
   20095/   19A3A : 6B00 0090           	bmi.w	SolidObject_TestClearPush	; Branch if object collisions are disabled for Sonic.
   20096/   19A3E : 0C29 0006 0024      	cmpi.b	#6,routine(a1)			; Is Sonic dead?
   20097/   19A44 : 6400 00AC           	bhs.w	SolidObject_NoCollision		; If yes, branch.
   20098/   19A48 : 4A78 FE08           	tst.w	(Debug_placement_mode).w
   20099/   19A4C : 6600 00A4           	bne.w	SolidObject_NoCollision		; Branch if in Debug Mode.
