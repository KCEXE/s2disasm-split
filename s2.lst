(1)  748/     1C3 : 16 1C 00 00 40 1C   	dw	zSongFM3,      0000h,  zSongFM4,  zSongFM5	; FM3, 0, FM4, FM5
              1C9 : 6A 1C             
(1)  749/     1CB : BE 1C E8 1C 12 1D   	dw	zSongPSG1, zSongPSG2, zSongPSG3, zSongPSG3	; PSG1, PSG2, PSG3, PSG3 (noise alternate)
              1D1 : 12 1D             
(1)  750/     1D3 :                     
