    6099/    4CAE :                     ; macro to simplify editing the demo scripts
    6100/    4CAE :                     demoinput macro buttons,duration
    6101/    4CAE :                     btns_mask := 0
    6102/    4CAE :                       irpc btn,"buttons"
    6103/    4CAE :                         switch "btn"
    6104/    4CAE :                         case "U"
    6105/    4CAE :                     btns_mask := btns_mask|button_up_mask
    6106/    4CAE :                         case "D"
    6107/    4CAE :                     btns_mask := btns_mask|button_down_mask
    6108/    4CAE :                         case "L"
    6109/    4CAE :                     btns_mask := btns_mask|button_left_mask
    6110/    4CAE :                         case "R"
    6111/    4CAE :                     btns_mask := btns_mask|button_right_mask
    6112/    4CAE :                         case "A"
    6113/    4CAE :                     btns_mask := btns_mask|button_A_mask
    6114/    4CAE :                         case "B"
    6115/    4CAE :                     btns_mask := btns_mask|button_B_mask
    6116/    4CAE :                         case "C"
    6117/    4CAE :                     btns_mask := btns_mask|button_C_mask
    6118/    4CAE :                         case "S"
    6119/    4CAE :                     btns_mask := btns_mask|button_start_mask
    6120/    4CAE :                         elsecase
    6121/    4CAE :                         endcase
    6122/    4CAE :                       endm
    6123/    4CAE :                     	dc.b	btns_mask,duration-1
    6124/    4CAE :                      endm
