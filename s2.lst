   22330/   A4B0C :                     ArtKos_MCZ:	BINCLUDE	"art/kosinski/MCZ.kos"
   22331/   A81EC :                     BM128_MCZ:	BINCLUDE	"mappings/128x128/MCZ.kos"
   22332/   AAD5C :                     
