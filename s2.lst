   21633/   45736 :                     ;---------------------------------------------------------------------------------------
   21634/   45736 :                     ; Offset index of level layouts
   21635/   45736 :                     ; Two entries per zone, pointing to the level layouts for acts 1 and 2 of each zone
   21636/   45736 :                     ; respectively.
   21637/   45736 :                     ;---------------------------------------------------------------------------------------
   21638/   45736 : (MACRO)              Off_Level: zoneOrderedOffsetTable 2,2
   21638/   45736 :  (MACRO-2)           Off_Level zoneOrderedTable 2,2
   21638/   45736 : =$45736              Off_Level label *
   21638/   45736 :                     ; set some global variables
   21638/   45736 : ="Off_Level"         .zone_table_name := "Off_Level"
   21638/   45736 : =$45736              .zone_table_addr := *
   21638/   45736 : =$2                  .zone_entry_len := 2
   21638/   45736 : =$2                  .zone_entries := 2
   21638/   45736 : =$0                  .zone_entries_left := 0
   21638/   45736 : =$0                  .cur_zone_id := 0
   21638/   45736 : ="0"                 .cur_zone_str := "0"
   21638/   45736 : =$45736              .current_offset_table := Off_Level
   21639/   45736 :                     	; EHZ
   21640/   45736 : (MACRO)              	zoneOffsetTableEntry.w Level_EHZ1	; Act 1
   21640/   45736 :  (MACRO-2)                   zoneTableEntry.w Level_EHZ1-.current_offset_table
   21640/   45736 :                                     !org .zone_table_addr+zone_id_{.cur_zone_str}*.zone_entry_len*.zone_entries
   21640/   45736 : 0044                                dc.w Level_EHZ1-.current_offset_table
   21640/   45738 : =$1                  .zone_entries_left := .zone_entries-1
   21640/   45738 : =$1                  .cur_zone_id := .cur_zone_id+1
   21640/   45738 : ="1"                 .cur_zone_str := "\{.cur_zone_id}"
   21640/   45738 :                                 shift
   21640/   45738 :   (MACRO-3)                      zoneTableEntry.w 
   21641/   45738 : (MACRO)              	zoneOffsetTableEntry.w Level_EHZ2	; Act 2
   21641/   45738 :  (MACRO-2)                   zoneTableEntry.w Level_EHZ2-.current_offset_table
   21641/   45738 : 01FA                                dc.w Level_EHZ2-.current_offset_table
   21641/   4573A : =$0                  .zone_entries_left := .zone_entries_left-1
   21641/   4573A :                                 shift
   21641/   4573A :   (MACRO-3)                      zoneTableEntry.w 
   21642/   4573A :                     	; Zone 1
   21643/   4573A : (MACRO)              	zoneOffsetTableEntry.w Level_Invalid	; Act 1
   21643/   4573A :  (MACRO-2)                   zoneTableEntry.w Level_Invalid-.current_offset_table
   21643/   4573A :                                     !org .zone_table_addr+zone_id_{.cur_zone_str}*.zone_entry_len*.zone_entries
   21643/   4573A : 0044                                dc.w Level_Invalid-.current_offset_table
   21643/   4573C : =$1                  .zone_entries_left := .zone_entries-1
   21643/   4573C : =$2                  .cur_zone_id := .cur_zone_id+1
   21643/   4573C : ="2"                 .cur_zone_str := "\{.cur_zone_id}"
   21643/   4573C :                                 shift
   21643/   4573C :   (MACRO-3)                      zoneTableEntry.w 
   21644/   4573C : (MACRO)              	zoneOffsetTableEntry.w Level_Invalid	; Act 2
   21644/   4573C :  (MACRO-2)                   zoneTableEntry.w Level_Invalid-.current_offset_table
   21644/   4573C : 0044                                dc.w Level_Invalid-.current_offset_table
   21644/   4573E : =$0                  .zone_entries_left := .zone_entries_left-1
   21644/   4573E :                                 shift
