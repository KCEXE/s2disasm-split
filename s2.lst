   16819/    D54E : 4841                	swap	d1
   16820/    D550 : 36C1                	move.w	d1,(a3)+	; Next row moves 3 times faster than top row, then next row is 4 times faster, then 5, etc.
   16821/    D552 : 4841                	swap	d1
   16822/    D554 : D280                	add.l	d0,d1
   16819/    D556 : 4841                	swap	d1
   16820/    D558 : 36C1                	move.w	d1,(a3)+	; Next row moves 3 times faster than top row, then next row is 4 times faster, then 5, etc.
   16821/    D55A : 4841                	swap	d1
   16822/    D55C : D280                	add.l	d0,d1
   16819/    D55E : 4841                	swap	d1
   16820/    D560 : 36C1                	move.w	d1,(a3)+	; Next row moves 3 times faster than top row, then next row is 4 times faster, then 5, etc.
