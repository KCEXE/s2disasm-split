   14264/    C504 :                     ; JUMP TABLE FOR SOFTWARE SCROLL MANAGERS
   14265/    C504 :                     ;
   14266/    C504 :                     ; "Software scrolling" is my term for what Nemesis (and by extension, the rest
   14267/    C504 :                     ; of the world) calls "rasterized layer deformation".* Software scroll managers
   14268/    C504 :                     ; are needed to achieve certain special camera effects - namely, locking the
   14269/    C504 :                     ; screen for a boss fight and defining the limits of said screen lock, or in
   14270/    C504 :                     ; the case of Sky Chase Zone ($10), moving the camera at a fixed rate through
   14271/    C504 :                     ; a predefined course.
   14272/    C504 :                     ; They are also used for things like controlling the parallax scrolling and
   14273/    C504 :                     ; water ripple effects in EHZ, and moving the clouds in HTZ and the stars in DEZ.
   14274/    C504 :                     ; ---------------------------------------------------------------------------
   14275/    C504 : (MACRO)              SwScrl_Index: zoneOrderedOffsetTable 2,1	; JmpTbl_SwScrlMgr
   14275/    C504 :  (MACRO-2)           SwScrl_Index zoneOrderedTable 2,1
   14275/    C504 : =$C504               SwScrl_Index label *
   14275/    C504 :                     ; set some global variables
   14275/    C504 : ="SwScrl_Index"      .zone_table_name := "SwScrl_Index"
   14275/    C504 : =$C504               .zone_table_addr := *
   14275/    C504 : =$2                  .zone_entry_len := 2
   14275/    C504 : =$1                  .zone_entries := 1
   14275/    C504 : =$0                  .zone_entries_left := 0
   14275/    C504 : =$0                  .cur_zone_id := 0
   14275/    C504 : ="0"                 .cur_zone_str := "0"
   14275/    C504 : =$C504               .current_offset_table := SwScrl_Index
   14276/    C504 : (MACRO)              	zoneOffsetTableEntry.w SwScrl_EHZ	; EHZ
   14276/    C504 :  (MACRO-2)                   zoneTableEntry.w SwScrl_EHZ-.current_offset_table
   14276/    C504 :                                     !org .zone_table_addr+zone_id_{.cur_zone_str}*.zone_entry_len*.zone_entries
   14276/    C504 : 0082                                dc.w SwScrl_EHZ-.current_offset_table
   14276/    C506 : =$0                  .zone_entries_left := .zone_entries-1
   14276/    C506 : =$1                  .cur_zone_id := .cur_zone_id+1
   14276/    C506 : ="1"                 .cur_zone_str := "\{.cur_zone_id}"
   14276/    C506 :                                 shift
   14276/    C506 :   (MACRO-3)                      zoneTableEntry.w 
