(1)  822/   1EA54 :                     
(1)  823/   1EA54 :                     ; ---------------------------------------------------------------------------
(1)  824/   1EA54 :                     ; This subroutine takes 'raw' bitmap-like collision block data as input and
(1)  825/   1EA54 :                     ; converts it into the proper collision arrays (ColArrayVertical and
(1)  826/   1EA54 :                     ; ColArrayHorizontal).
(1)  827/   1EA54 :                     ; Pointers to said raw data are dummied out.
(1)  828/   1EA54 :                     ; Curiously, an example of the original 'raw' data that this was intended
(1)  829/   1EA54 :                     ; to process can be found in the J2ME version of Sonic 1, in a file called
(1)  830/   1EA54 :                     ; 'blkcol.bct'.
(1)  831/   1EA54 :                     ; This subroutine exists in Sonic 1 as well, but was oddly changed in
(1)  832/   1EA54 :                     ; the S2 Nick Arcade prototype to just handle loading GHZ's collision
(1)  833/   1EA54 :                     ; instead (though it too is dummied out, hence collision being broken).
(1)  834/   1EA54 :                     ; ---------------------------------------------------------------------------
(1)  835/   1EA54 :                     
(1)  836/   1EA54 : =$42DA4              RawColBlocks		= ColArrayVertical
(1)  837/   1EA54 : =$42DA4              ConvRowColBlocks	= ColArrayVertical
(1)  838/   1EA54 :                     
(1)  839/   1EA54 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
(1)  840/   1EA54 :                     
(1)  841/   1EA54 :                     ; return_1EAF0: FloorLog_Unk:
(1)  842/   1EA54 :                     ConvertCollisionArray:
(1)  843/   1EA54 : 4E75                	rts
(1)  844/   1EA56 :                     ; ---------------------------------------------------------------------------
(1)  845/   1EA56 :                     	; The raw format stores the collision data column by column for the normal collision array.
(1)  846/   1EA56 :                     	; This makes a copy of the data, but stored row by row, for the rotated collision array.
(1)  847/   1EA56 : 43F9 0004 2DA4      	lea	(RawColBlocks).l,a1	; Source location of raw collision block data
(1)  848/   1EA5C : 45F9 0004 2DA4      	lea	(ConvRowColBlocks).l,a2	; Destinatation location for row-converted collision block data
(1)  849/   1EA62 :                     
(1)  850/   1EA62 : 363C 00FF           	move.w	#$100-1,d3	; Number of blocks in collision data
(1)  851/   1EA66 :                     .blockLoop:
(1)  852/   1EA66 : 7A10                	moveq	#16,d5		; Start on the 16th bit (the leftmost pixel)
(1)  853/   1EA68 :                     
(1)  854/   1EA68 : 343C 000F           	move.w	#16-1,d2	; Width of a block in pixels
(1)  855/   1EA6C :                     .columnLoop:
(1)  856/   1EA6C : 7800                	moveq	#0,d4
(1)  857/   1EA6E :                     
(1)  858/   1EA6E : 323C 000F           	move.w	#16-1,d1	; Height of a block in pixels
(1)  859/   1EA72 :                     .rowLoop:
