   13485/    B2B8 :                     ; macro for declaring pointer/position structures for intro/credit text
   13486/    B2B8 : =$C000               vram_pnt := VRAM_Plane_A_Name_Table
   13487/    B2B8 :                     creditsPtrs macro addr,pos
   13488/    B2B8 :                     	if "addr"<>""
   13489/    B2B8 :                     		dc.l addr
   13490/    B2B8 :                     		dc.w vram_pnt + pos
   13491/    B2B8 :                     		shift
   13492/    B2B8 :                     		shift
   13493/    B2B8 :                     		creditsPtrs ALLARGS
   13494/    B2B8 :                     	else
   13495/    B2B8 :                     		dc.w -1
   13496/    B2B8 :                     	endif
   13497/    B2B8 :                         endm
