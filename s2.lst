   17107/    D712 : 6636                	bne.s	.return		; if a teleport is in progress, return
   17124/    D714 :                     	; The intent of this code is to make the camera briefly lag behind the
   17125/    D714 :                     	; player right after releasing a spin dash, however it does this by
   17126/    D714 :                     	; simply making the camera use position data from previous frames. This
   17127/    D714 :                     	; means that if the camera had been moving recently enough, then
   17128/    D714 :                     	; releasing a spin dash will cause the camera to jerk around instead of
   17129/    D714 :                     	; remain still. This can be encountered by running into a wall, and
   17130/    D714 :                     	; quickly turning around and spin dashing away. Sonic 3 would have had
   17131/    D714 :                     	; this same issue with the Fire Shield's dash abiliity, but it shoddily
   17132/    D714 :                     	; works around the issue by resetting the old position values to the
   17133/    D714 :                     	; current position (see 'Reset_Player_Position_Array').
   17134/    D714 : 3215                	move.w	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
   17135/    D716 : 671E                	beq.s	.scrollNotDelayed				; if not, branch
   17136/    D718 : 0441 0100           	subi.w	#$100,d1					; reduce delay value
   17137/    D71C : 3A81                	move.w	d1,Horiz_scroll_delay_val-Camera_Delay(a5)
   17138/    D71E : 7200                	moveq	#0,d1
