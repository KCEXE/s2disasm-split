   21324/   3677E :                     ;
   21325/   3677E :                     ;  a2 = projectile stat list
   21326/   3677E :                     ;   format:
   21327/   3677E :                     ;   dc.b x_offset, y_offset, x_vel, y_vel, mapping_frame, render_flags
   21328/   3677E :                     ;
