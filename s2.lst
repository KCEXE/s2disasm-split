(1)  701/     194 :                     
(1)  702/     194 : 10 FE               	djnz	$			; 8	; Busy wait for specific amount of time in 'b'
(1)  703/     196 :                     
(1)  704/     196 : F3                  	di				; 4	; disable interrupts (while updating DAC)
(1)  705/     197 : F5                  	push	af			; 11
(1)  706/     198 : F1                  	pop	af			; 11
(1)  707/     199 : 3E 2A               	ld	a,2Ah			; 7	; DAC port
(1)  708/     19B : 32 00 40            	ld	(zYM2612_A0),a		; 13	; Set DAC port register
(1)  709/     19E : 41                  	ld	b,c			; 4	; reload 'b' with wait value
(1)  710/     19F : 7E                  	ld	a,(hl)			; 7	; Get next DAC byte
(1)  711/     1A0 : 23                  	inc	hl			; 6	; Next byte in DAC stream...
(1)  712/     1A1 : 1B                  	dec	de			; 6	; One less byte
