   17950/    DD00 :                     ;Draw_BG2_SBZ:
   17951/    DD00 :                     	; Chemical Plant Zone uses a lighty-modified version this code.
   17952/    DD00 :                     	; This is an advanced form of the usual background-drawing code that
   17953/    DD00 :                     	; allows each row of blocks to update and scroll independently...
   17954/    DD00 :                     	; kind of. There are only three possible 'cameras' that each row can
   17955/    DD00 :                     	; align itself with. Still, each row is free to decide which camera
   17956/    DD00 :                     	; it aligns with.
   17957/    DD00 :                     	; This could have really benefitted Oil Ocean Zone's background,
   17958/    DD00 :                     	; which has a section that goes unseen because the regular background
   17959/    DD00 :                     	; drawer is too primitive to display it without making the sun and
   17960/    DD00 :                     	; clouds disappear. Using this would have avoided that.
   17961/    DD00 :                     
   17962/    DD00 :                     	; Handle loading the rows as the camera moves up and down.
   17963/    DD00 : 78F0                	moveq	#-16,d4	; Y offset (relative to camera)
   17964/    DD02 : 0892 0000           	bclr	#scroll_flag_advanced_bg_up,(a2)
   17965/    DD06 : 660A                	bne.s	.doUpOrDown
   17966/    DD08 : 0892 0001           	bclr	#scroll_flag_advanced_bg_down,(a2)
   17967/    DD0C : 674C                	beq.s	.checkIfShouldDoLeftOrRight
   17968/    DD0E : 383C 00E0           	move.w	#224,d4	; Y offset (relative to camera)
