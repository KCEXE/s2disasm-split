   22758/   E201C : 3681                	move.w	d1,(a3)	; get Z80 bus
   22759/   E201E : 3481                	move.w	d1,(a2)	; release Z80 reset (was held high by console on startup)
   22760/   E2020 : 0513                -	btst	d2,(a3)
