   19715/   19720 :                     ; Solid object subroutines (includes spikes, blocks, rocks etc)
   19716/   19720 :                     ; These check collision of Sonic/Tails with objects on the screen
   19717/   19720 :                     ;
   19718/   19720 :                     ; input variables:
   19719/   19720 :                     ; d1 = object width / 2
   19720/   19720 :                     ; d2 = object height / 2 (when jumping)
   19721/   19720 :                     ; d3 = object height / 2 (when walking)
   19722/   19720 :                     ; d4 = object x-axis position
   19723/   19720 :                     ;
   19724/   19720 :                     ; address registers:
   19725/   19720 :                     ; a0 = the object to check collision with
   19726/   19720 :                     ; a1 = Sonic or Tails (set inside these subroutines)
   19727/   19720 :                     ; ---------------------------------------------------------------------------
