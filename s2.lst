   20161/   19AA6 : 5404                	addq.b	#pushing_bit_delta,d4	; Character is pushing, not standing
   20162/   19AA8 : 09E8 0022           	bset	d4,status(a0)		; make object be pushed
   20163/   19AAC : 08E9 0005 0022      	bset	#5,status(a1)		; make Sonic push object
   20164/   19AB2 : 3806                	move.w	d6,d4
