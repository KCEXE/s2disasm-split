   19297/    E542 :                     
   19298/    E542 :                     ;EliminateChunkDuplicates:
   19299/    E542 :                     	; This is a chunk de-duplicator.
   19300/    E542 :                     
   19301/    E542 :                     	; Copy first chunk into 'Chunk_Table'.
   19302/    E542 : 43F9 00FE 0000      	lea	($FE0000).l,a1
   19303/    E548 : 47F9 FFFF 0000      	lea	(Chunk_Table).l,a3
   19304/    E54E :                     
   19305/    E54E : 701F                	moveq	#bytesToLcnt(8*8*2),d0
   19306/    E550 : 26D9                -	move.l	(a1)+,(a3)+
   19307/    E552 : 51C8 FFFC           	dbf	d0,-
   19308/    E556 :                     
   19309/    E556 : 7E00                	moveq	#0,d7	; This holds how many chunks have been copied minus 1.
   19310/    E558 : 43F9 00FE 0000      	lea	($FE0000).l,a1
   19311/    E55E : 3A3C 00FF           	move.w	#$100-1,d5	; $100 chunks
   19312/    E562 :                     ;loc_E55A:
   19313/    E562 :                     .nextChunk:
   19314/    E562 : 47F9 FFFF 0000      	lea	(Chunk_Table).l,a3
   19315/    E568 : 3C07                	move.w	d7,d6
   19316/    E56A :                     
   19317/    E56A :                     .doNextComparison:
   19318/    E56A : 48E7 0070           	movem.l	a1-a3,-(sp)
   19319/    E56E :                     
   19320/    E56E :                     	; Compare chunks.
   19321/    E56E : 303C 003F           	move.w	#bytesToWcnt(8*8*2),d0
   19322/    E572 : B749                -	cmpm.w	(a1)+,(a3)+
   19323/    E574 : 6612                	bne.s	+
   19324/    E576 : 51C8 FFFA           	dbf	d0,-
   19325/    E57A :                     
   19326/    E57A :                     	; The chunks match.
   19327/    E57A : 4CDF 0E00           	movem.l	(sp)+,a1-a3
   19328/    E57E : D2FC 0080           	adda.w	#8*8*2,a1
   19329/    E582 : 51CD FFDE           	dbf	d5,.nextChunk
   19330/    E586 :                     
   19331/    E586 : 601A                	bra.s	++
   19332/    E588 :                     ; ===========================================================================
   19333/    E588 :                     +
   19334/    E588 :                     	; No match: check the next chunk.
   19335/    E588 : 4CDF 0E00           	movem.l	(sp)+,a1-a3
   19336/    E58C : D6FC 0080           	adda.w	#8*8*2,a3
   19337/    E590 : 51CE FFD8           	dbf	d6,.doNextComparison
   19338/    E594 :                     
   19339/    E594 :                     	; Not a single match.
   19340/    E594 :                     
   19341/    E594 :                     	; Add this chunk to the output.
   19342/    E594 : 701F                	moveq	#bytesToLcnt(8*8*2),d0
   19343/    E596 : 26D9                -	move.l	(a1)+,(a3)+
   19344/    E598 : 51C8 FFFC           	dbf	d0,-
   19345/    E59C :                     
   19346/    E59C : 5287                	addq.l	#1,d7	; One more chunk has been added.
   19347/    E59E : 51CD FFC2           	dbf	d5,.nextChunk
   19348/    E5A2 :                     /
