   10425/    7A66 :                     ; ===========================================================================
   10426/    7A66 :                     
   10427/    7A66 :                      ; temporarily remap characters to title card letter format
   10428/    7A66 :                      ; Characters are encoded as Aa, Bb, Cc, etc. through a macro
   10429/    7A66 :                      charset 'A',0	; can't have an embedded 0 in a string
   10430/    7A66 :                      charset 'B',"\4\8\xC\4\x10\x14\x18\x1C\x1E\x22\x26\x2A\4\4\x30\x34\x38\x3C\x40\x44\x48\x4C\x52\x56\4"
   10431/    7A66 :                      charset 'a',"\4\4\4\4\4\4\4\4\2\4\4\4\6\4\4\4\4\4\4\4\4\4\6\4\4"
   10432/    7A66 :                      charset '.',"\x5A"
   10433/    7A66 :                     
   10434/    7A66 :                     ; Defines which letters load for the continue screen
   10435/    7A66 :                     ; Each letter occurs only once, and  the letters ENOZ (i.e. ZONE) aren't loaded here
   10436/    7A66 :                     ; However, this is hidden by the titleLetters macro, and normal titles can be used
   10437/    7A66 :                     ; (the macro is defined near SpecialStage_ResultsLetters, which uses it before here)
   10438/    7A66 :                     
   10439/    7A66 :                     ; word_7A5E:
   10440/    7A66 :                     ContinueScreen_AdditionalLetters:
   10441/    7A66 : (MACRO)              	titleLetters "CONTINUE"
   10441/    7A66 :                          ;  ". ZYXWVUTSRQPONMLKJIHGFEDCBA"
   10441/    7A66 : =$6006010            used := %0110000000000110000000010000   ; set to initial state
   10441/    7A66 :                         irpc char,"CONTINUE"
   10441/    7A66 :                             if ~~(used&1<<strstr(llookup,"char"))   ; has the letter been used already?
   10441/    7A66 :                     used := used|1<<strstr(llookup,"char")  ; if not, mark it as used
   10441/    7A66 :                             dc.b "char"                     ; output letter code
   10441/    7A66 :                             if "char"=="."
   10441/    7A66 :                             dc.b 2                  ; output character size
   10441/    7A66 :                             else
   10441/    7A66 :                             dc.b lowstring("char")  ; output letter size
   10441/    7A66 :                             endif
   10441/    7A66 :                             endif
   10441/    7A66 :                         endm
   10441/    7A66 : =$6006014            used := used|1<<strstr(llookup,"C")  ; if not, mark it as used
   10441/    7A66 : 08                          dc.b "C"                     ; output letter code
   10441/    7A67 : 04                          dc.b lowstring("C")  ; output letter size
   10441/    7A68 : =$6086014            used := used|1<<strstr(llookup,"T")  ; if not, mark it as used
   10441/    7A68 : 40                          dc.b "T"                     ; output letter code
   10441/    7A69 : 04                          dc.b lowstring("T")  ; output letter size
   10441/    7A6A : =$6086114            used := used|1<<strstr(llookup,"I")  ; if not, mark it as used
