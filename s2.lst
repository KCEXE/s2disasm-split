    4396/    3C36 : 4A51                -	tst.w	(a1)	; The masking sprite has its art-tile set to $0000.
    4397/    3C38 : 6608                	bne.s	+
    4398/    3C3A : 0840 0002           	bchg	#2,d0	; Alternate between X positions of 0 and 4.
    4399/    3C3E : 3340 0002           	move.w	d0,2(a1)
    4400/    3C42 : 5049                +	addq.w	#8,a1
