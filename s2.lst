   20104/   19A56 :                     
   20105/   19A56 :                     ;.isToTheRight:
   20106/   19A56 : D241                	add.w	d1,d1
   20107/   19A58 : 9041                	sub.w	d1,d0
   20108/   19A5A : 3A00                	move.w	d0,d5			; Calculate Sonic's distance to the object's right edge...
   20109/   19A5C : 4445                	neg.w	d5			; ...and calculate the absolute value.
   20110/   19A5E :                     
