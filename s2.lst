(1) 4032/    12E8 :                     ; This is an ugly countdown to zero implemented in repeatedly modifying code!!
(1) 4033/    12E8 :                     ; But basically, it starts at the full length of the song +1 (so it can decrement)
(1) 4034/    12E8 :                     ; and waits until 'hl' decrements to zero
(1) 4035/    12E8 :                     ; zsub_12E8
(1) 4036/    12E8 :                     zDecEndOrGetByte:
(1) 4037/    12E8 : 21 00 00            	ld	hl,0			; Self-modified code: starts at full length of song +1, waits until it gets to 1...
(1) 4043/    12EB : 2B                  	dec	hl			; ...where this will be zero
(1) 4044/    12EC : 22 E9 12            	ld	(zDecEndOrGetByte+1),hl	; Self-modified code: update the count in case it's not zero
(1) 4046/    12EF : 7C                  	ld	a,h
(1) 4047/    12F0 : B5                  	or	l
(1) 4048/    12F1 : 28 09               	jr	z,zDecEnd		; If 'h' and 'l' both equal zero, we quit!!
(1) 4050/    12F3 :                     
(1) 4051/    12F3 :                     ; zloc_12F3
(1) 4052/    12F3 :                     zGetNextByte:
(1) 4053/    12F3 : 21 00 00            	ld	hl,0			; Self-modified code: get address of next compressed byte
(1) 4054/    12F6 : 7E                  	ld	a,(hl)			; put it into -> 'a'
(1) 4055/    12F7 : 23                  	inc	hl			; next byte...
(1) 4056/    12F8 : 22 F4 12            	ld	(zGetNextByte+1),hl	; change inst @ zGetNextByte so it loads next compressed byte
(1) 4057/    12FB : C9                  	ret				; still going...
(1) 4058/    12FC :                     
(1) 4059/    12FC :                     ; zloc_12FC
(1) 4060/    12FC :                     zDecEnd:
(1) 4061/    12FC : E1                  	pop	hl			; throws away return address to this function call so that next 'ret' exits decompressor (we're done!)
(1) 4062/    12FD : C9                  	ret				; Exit decompressor
(1) 4063/    12FE :                     ; End of function zDecEndOrGetByte
(1) 4064/    12FE :                     
(1) 4065/    12FE :                     ; ---------------------------------------------------------------------------
(1) 4066/    12FE :                     	; space for a few global variables
(1) 4067/    12FE :                     
(1) 4068/    12FE : 00                  zPALUpdTick:	db 0 ; zbyte_12FE ; This counts from 0 to 5 to periodically "double update" for PAL systems (basically every 6 frames you need to update twice to keep up)
(1) 4069/    12FF : 00                  zCurDAC:	db 0 ; zbyte_12FF ; seems to indicate DAC sample playing status
(1) 4070/    1300 : 00                  zCurSong:	db 0 ; zbyte_1300 ; currently playing song index
(1) 4071/    1301 : 00                  zDoSFXFlag:	db 0 ; zbyte_1301 ; flag to indicate we're updating SFX (and thus use custom voice table); set to anything but 0 while doing SFX, 0 when not.
(1) 4072/    1302 : 00                  zRingSpeaker:	db 0 ; zbyte_1302 ; stereo alternation flag. 0 = next one plays on left, -1 = next one plays on right
(1) 4073/    1303 : 00                  zGloopFlag:	db 0 ; zbyte_1303 ; if -1, don't play the gloop sound next time
(1) 4074/    1304 : 00                  zSpindashPlayingCounter:	db 0 ; zbyte_1304
(1) 4075/    1305 : 00                  zSpindashExtraFrequencyIndex:	db 0 ; zbyte_1305
(1) 4076/    1306 : 00                  zSpindashActiveFlag:		db 0 ; zbyte_1306 ; -1 if spindash charge was the last sound that played
(1) 4077/    1307 : 00                  zPaused:	db 0 ; zbyte_1307 ; 0 = normal, -1 = pause all sound and music
