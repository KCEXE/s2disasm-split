(1) 1432/   1583A :                     
(1) 1433/   1583A :                      ; temporarily remap characters to title card letter format
(1) 1434/   1583A :                      ; Characters are encoded as Aa, Bb, Cc, etc. through a macro
(1) 1435/   1583A :                      charset 'A',0	; can't have an embedded 0 in a string
(1) 1436/   1583A :                      charset 'B',"\4\8\xC\4\x10\x14\x18\x1C\x1E\x22\x26\x2A\4\4\x30\x34\x38\x3C\x40\x44\x48\x4C\x52\x56\4"
(1) 1437/   1583A :                      charset 'a',"\4\4\4\4\4\4\4\4\2\4\4\4\6\4\4\4\4\4\4\4\4\4\6\4\4"
(1) 1438/   1583A :                      charset '.',"\x5A"
(1) 1439/   1583A :                     
(1) 1440/   1583A :                     ; Defines which letters load for the continue screen
(1) 1441/   1583A :                     ; Each letter occurs only once, and  the letters ENOZ (i.e. ZONE) aren't loaded here
(1) 1442/   1583A :                     ; However, this is hidden by the titleLetters macro, and normal titles can be used
(1) 1443/   1583A :                     ; (the macro is defined near SpecialStage_ResultsLetters, which uses it before here)
(1) 1444/   1583A :                     
(1) 1445/   1583A :                     ; word_15832:
(1) 1446/   1583A :                     TitleCardLetters:
(1) 1447/   1583A :                     
(1) 1448/   1583A :                     TitleCardLetters_EHZ:
(1) 1449/   1583A : (MACRO)              	titleLetters	"EMERALD HILL"
(1) 1449/   1583A :                          ;  ". ZYXWVUTSRQPONMLKJIHGFEDCBA"
(1) 1449/   1583A : =$6006010            used := %0110000000000110000000010000   ; set to initial state
(1) 1449/   1583A :                         irpc char,"EMERALD HILL"
(1) 1449/   1583A :                             if ~~(used&1<<strstr(llookup,"char"))   ; has the letter been used already?
(1) 1449/   1583A :                     used := used|1<<strstr(llookup,"char")  ; if not, mark it as used
(1) 1449/   1583A :                             dc.b "char"                     ; output letter code
(1) 1449/   1583A :                             if "char"=="."
(1) 1449/   1583A :                             dc.b 2                  ; output character size
(1) 1449/   1583A :                             else
(1) 1449/   1583A :                             dc.b lowstring("char")  ; output letter size
(1) 1449/   1583A :                             endif
(1) 1449/   1583A :                             endif
(1) 1449/   1583A :                         endm
(1) 1449/   1583A : =$6007010            used := used|1<<strstr(llookup,"M")  ; if not, mark it as used
(1) 1449/   1583A : 2A                          dc.b "M"                     ; output letter code
(1) 1449/   1583B : 06                          dc.b lowstring("M")  ; output letter size
(1) 1449/   1583C : =$6027010            used := used|1<<strstr(llookup,"R")  ; if not, mark it as used
(1) 1449/   1583C : 38                          dc.b "R"                     ; output letter code
(1) 1449/   1583D : 04                          dc.b lowstring("R")  ; output letter size
(1) 1449/   1583E : =$6027011            used := used|1<<strstr(llookup,"A")  ; if not, mark it as used
(1) 1449/   1583E : 00                          dc.b "A"                     ; output letter code
(1) 1449/   1583F : 04                          dc.b lowstring("A")  ; output letter size
(1) 1449/   15840 : =$6027811            used := used|1<<strstr(llookup,"L")  ; if not, mark it as used
(1) 1449/   15840 : 26                          dc.b "L"                     ; output letter code
(1) 1449/   15841 : 04                          dc.b lowstring("L")  ; output letter size
(1) 1449/   15842 : =$6027819            used := used|1<<strstr(llookup,"D")  ; if not, mark it as used
(1) 1449/   15842 : 0C                          dc.b "D"                     ; output letter code
(1) 1449/   15843 : 04                          dc.b lowstring("D")  ; output letter size
(1) 1449/   15844 : =$6027899            used := used|1<<strstr(llookup,"H")  ; if not, mark it as used
(1) 1449/   15844 : 18                          dc.b "H"                     ; output letter code
(1) 1449/   15845 : 04                          dc.b lowstring("H")  ; output letter size
(1) 1449/   15846 : =$6027999            used := used|1<<strstr(llookup,"I")  ; if not, mark it as used
