   17972/    DD16 : 3038 EE0C           	move.w	(Camera_BG_Y_pos).w,d0
   17973/    DD1A : D044                	add.w	d4,d0
   17974/    DD1C : 0240 01F0           	andi.w	#$1F0,d0	; After right-shifting, the is a mask of $1F. Since SBZ_CameraSections is $20 items long, this is correct.
   17975/    DD20 : E848                	lsr.w	#4,d0
   17976/    DD22 : 1030 0000           	move.b	(a0,d0.w),d0
   17977/    DD26 : 47F9 0000 DE86      	lea	(BGCameraLookup).l,a3
   17978/    DD2C : 3673 0000           	movea.w	(a3,d0.w),a3	; Camera, either BG, BG2 or BG3 depending on Y
   17979/    DD30 : 6714                	beq.s	.doWholeRow
   17980/    DD32 : 7AF0                	moveq	#-16,d5	; X offset (relative to camera)
   17981/    DD34 : 48E7 0C00           	movem.l	d4-d5,-(sp)
   17982/    DD38 : 6100 0554           	bsr.w	CalculateVRAMAddressOfBlockForPlayer1
   17983/    DD3C : 4CDF 0030           	movem.l	(sp)+,d4-d5
