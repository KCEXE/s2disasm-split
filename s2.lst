   17217/    D79C : 6702                	beq.s	.notRolling	; if not, branch
   17218/    D79E : 5B40                	subq.w	#5,d0		; subtract difference between standing and rolling heights
   17229/    D7A0 :                     ; loc_D798:
   17230/    D7A0 :                     .notRolling:
   17231/    D7A0 : 0828 0001 0022      	btst	#1,status(a0)			; is the player in the air?
   17232/    D7A6 : 6716                	beq.s	.checkBoundaryCrossed_onGround	; if not, branch
   17233/    D7A8 :                     ;.checkBoundaryCrossed_inAir:
   17234/    D7A8 :                     	; If Sonic's in the air, he has $20 pixels above and below him to move without disturbing the camera.
   17235/    D7A8 :                     	; The camera movement is also only capped at $10 pixels.
   17236/    D7A8 : 0640 0020           	addi.w	#$20,d0
   17237/    D7AC : 9043                	sub.w	d3,d0
   17238/    D7AE : 6554                	bcs.s	.doScroll_fast	; If Sonic is above the boundary, scroll to catch up to him
   17239/    D7B0 : 0440 0040           	subi.w	#$40,d0
