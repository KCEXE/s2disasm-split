   19192/    E48A :                     
   19193/    E48A :                     ;loadLevelLayout_Sonic1:
   19194/    E48A :                     	; This loads level layout data in Sonic 1's format. Curiously, this
   19195/    E48A :                     	; function has been changed since Sonic 1: in particular, it repeats
   19196/    E48A :                     	; the rows of the source data to fill the rows of the destination
   19197/    E48A :                     	; data, which provides some explanation for why so many of Sonic 2's
   19198/    E48A :                     	; backgrounds are repeated in their layout data. This repeating is
   19199/    E48A :                     	; needed to prevent Hidden Palace Zone's background from disappearing
   19200/    E48A :                     	; when the player moves to the left.
   19201/    E48A :                     
   19202/    E48A :                     	; Clear layout data.
   19203/    E48A : 47F8 8000           	lea	(Level_Layout).w,a3
   19204/    E48E : 323C 03FF           	move.w	#bytesToLcnt(Level_Layout_End-Level_Layout),d1
   19205/    E492 : 7000                	moveq	#0,d0
   19206/    E494 : 26C0                -	move.l	d0,(a3)+
   19207/    E496 : 51C9 FFFC           	dbf	d1,-
   19208/    E49A :                     
   19209/    E49A :                     	; The rows of the foreground and background layouts are interleaved
   19210/    E49A :                     	; in memory. This is done here:
   19211/    E49A : 47F8 8000           	lea	(Level_Layout).w,a3	; Foreground.
   19212/    E49E : 7200                	moveq	#0,d1			; Index into 'Off_Level' to get level foreground layout.
   19213/    E4A0 : 6100 0008           	bsr.w	.loadLayout
   19214/    E4A4 : 47F8 8080           	lea	(Level_Layout+$80).w,a3	; Background.
   19215/    E4A8 : 7202                	moveq	#2,d1			; Index into 'Off_Level' to get level background layout.
   19216/    E4AA :                     
   19217/    E4AA :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   19218/    E4AA :                     
   19219/    E4AA :                     ; sub_E4A2:
   19220/    E4AA :                     .loadLayout:
   19221/    E4AA :                     	; This expects 'Off_Level' to be in the format that it was in
   19222/    E4AA :                     	; Sonic 1.
   19223/    E4AA : 7000                	moveq	#0,d0
   19224/    E4AC : 3038 FE10           	move.w	(Current_ZoneAndAct).w,d0
   19225/    E4B0 : E218                	ror.b	#1,d0
   19226/    E4B2 : EA48                	lsr.w	#5,d0
   19227/    E4B4 : D041                	add.w	d1,d0
   19228/    E4B6 : 43F9 0004 5736      	lea	(Off_Level).l,a1
   19229/    E4BC : 3031 0000           	move.w	(a1,d0.w),d0
   19230/    E4C0 : 43F1 0800           	lea	(a1,d0.l),a1
   19231/    E4C4 :                     
   19232/    E4C4 : 7200                	moveq	#0,d1
   19233/    E4C6 : 3401                	move.w	d1,d2
   19234/    E4C8 : 1219                	move.b	(a1)+,d1	; Layout width.
   19235/    E4CA : 1419                	move.b	(a1)+,d2	; Layout height.
   19236/    E4CC : 2A01                	move.l	d1,d5
   19237/    E4CE : 5285                	addq.l	#1,d5
   19238/    E4D0 : 7600                	moveq	#0,d3
   19239/    E4D2 : 363C 0080           	move.w	#$80,d3	; Size of layout row in memory.
   19240/    E4D6 : 86C5                	divu.w	d5,d3	; Get how many times to repeat the source row to fill the destination row.
   19241/    E4D8 : 5343                	subq.w	#1,d3	; Turn into loop counter.
   19242/    E4DA :                     
   19243/    E4DA :                     .nextRow:
   19244/    E4DA : 204B                	movea.l	a3,a0
   19245/    E4DC :                     
   19246/    E4DC : 3803                	move.w	d3,d4
   19247/    E4DE :                     .repeatRow:
   19248/    E4DE : 2F09                	move.l	a1,-(sp)
   19249/    E4E0 :                     
   19250/    E4E0 : 3001                	move.w	d1,d0
   19251/    E4E2 :                     .nextByte:
   19252/    E4E2 : 10D9                	move.b	(a1)+,(a0)+
   19253/    E4E4 : 51C8 FFFC           	dbf	d0,.nextByte
   19254/    E4E8 :                     
   19255/    E4E8 : 225F                	movea.l	(sp)+,a1
   19256/    E4EA : 51CC FFF2           	dbf	d4,.repeatRow
   19257/    E4EE :                     
   19258/    E4EE : 43F1 5000           	lea	(a1,d5.w),a1	; Next row in source data.
   19259/    E4F2 : 47EB 0100           	lea	$100(a3),a3	; Next row in destination data.
   19260/    E4F6 : 51CA FFE2           	dbf	d2,.nextRow
   19261/    E4FA :                     
   19262/    E4FA : 4E75                	rts
   19263/    E4FC :                     ; End of function .loadLayout
