   14305/    C534 : 4442                	neg.w	d2
   14306/    C536 : E442                	asr.w	#2,d2
   14307/    C538 :                     
   14308/    C538 :                     	; Update the background's (and foreground's) horizontal scrolling.
   14309/    C538 : 43F8 E000           	lea	(Horiz_Scroll_Buf).w,a1
   14310/    C53C :                     
   14311/    C53C :                     	; Do 160 lines that don't move.
   14312/    C53C : 7000                	moveq	#0,d0
   14313/    C53E : 323C 009F           	move.w	#160-1,d1
   14314/    C542 : 22C0                -	move.l	d0,(a1)+
   14315/    C544 : 51C9 FFFC           	dbf	d1,-
   14316/    C548 :                     
   14317/    C548 :                     	; Do 32 lines that scroll with the camera.
   14318/    C548 : 3002                	move.w	d2,d0
   14319/    C54A : 323C 001F           	move.w	#32-1,d1
   14320/    C54E : 22C0                -	move.l	d0,(a1)+
   14321/    C550 : 51C9 FFFC           	dbf	d1,-
   14322/    C554 :                     
   14323/    C554 : 3600                	move.w	d0,d3
   14324/    C556 :                     	; Make the 'ripple' animate every 8 frames.
   14325/    C556 : 1238 FE0F           	move.b	(Vint_runcount+3).w,d1
   14326/    C55A : 0241 0007           	andi.w	#7,d1
   14327/    C55E : 6604                	bne.s	+
   14328/    C560 : 5378 A800           	subq.w	#1,(TempArray_LayerDef).w
   14329/    C564 :                     +
   14330/    C564 : 3238 A800           	move.w	(TempArray_LayerDef).w,d1
   14331/    C568 : 0241 001F           	andi.w	#$1F,d1
   14332/    C56C : 45FA 011C           	lea	SwScrl_RippleData(pc),a2
   14333/    C570 : 45F2 1000           	lea	(a2,d1.w),a2
   14334/    C574 :                     
   14335/    C574 :                     	; Do 16 lines that scroll with the camera and 'ripple'.
