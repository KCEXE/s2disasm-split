   20149/   19A86 : 4A69 0010           	tst.w	x_vel(a1)		; is Sonic moving right?
   20150/   19A8A : 6A0C                	bpl.s	SolidObject_AtEdge	; if yes, branch
   20151/   19A8C :                     ; loc_19A84:
