(1)  160/       0 :                     ; Bits 3-6 of an object's status after a SolidObject call is a
(1)  161/       0 :                     ; bitfield with the following meaning:
(1)  162/       0 : =$3                  p1_standing_bit   = 3
(1)  163/       0 : =$4                  p2_standing_bit   = p1_standing_bit + 1
(1)  164/       0 :                     
(1)  165/       0 : =$8                  p1_standing       = 1<<p1_standing_bit
(1)  166/       0 : =$10                 p2_standing       = 1<<p2_standing_bit
(1)  167/       0 :                     
(1)  168/       0 : =$2                  pushing_bit_delta = 2
(1)  169/       0 : =$5                  p1_pushing_bit    = p1_standing_bit + pushing_bit_delta
(1)  170/       0 : =$6                  p2_pushing_bit    = p1_pushing_bit + 1
(1)  171/       0 :                     
(1)  172/       0 : =$20                 p1_pushing        = 1<<p1_pushing_bit
(1)  173/       0 : =$40                 p2_pushing        = 1<<p2_pushing_bit
(1)  174/       0 :                     
(1)  175/       0 :                     
(1)  176/       0 : =$18                 standing_mask     = p1_standing|p2_standing
(1)  177/       0 : =$60                 pushing_mask      = p1_pushing|p2_pushing
(1)  178/       0 :                     
(1)  179/       0 :                     ; ---------------------------------------------------------------------------
(1)  180/       0 :                     ; The high word of d6 after a SolidObject call is a bitfield
(1)  181/       0 :                     ; with the following meaning:
(1)  182/       0 : =$0                  p1_touch_side_bit   = 0
(1)  183/       0 : =$1                  p2_touch_side_bit   = p1_touch_side_bit + 1
(1)  184/       0 :                     
(1)  185/       0 : =$1                  p1_touch_side       = 1<<p1_touch_side_bit
(1)  186/       0 : =$2                  p2_touch_side       = 1<<p2_touch_side_bit
(1)  187/       0 :                     
(1)  188/       0 : =$3                  touch_side_mask     = p1_touch_side|p2_touch_side
(1)  189/       0 :                     
(1)  190/       0 : =$2                  p1_touch_bottom_bit = p1_touch_side_bit + pushing_bit_delta
(1)  191/       0 : =$3                  p2_touch_bottom_bit = p1_touch_bottom_bit + 1
(1)  192/       0 :                     
(1)  193/       0 : =$4                  p1_touch_bottom     = 1<<p1_touch_bottom_bit
(1)  194/       0 : =$8                  p2_touch_bottom     = 1<<p2_touch_bottom_bit
(1)  195/       0 :                     
(1)  196/       0 : =$C                  touch_bottom_mask   = p1_touch_bottom|p2_touch_bottom
(1)  197/       0 :                     
(1)  198/       0 : =$4                  p1_touch_top_bit   = p1_touch_bottom_bit + pushing_bit_delta
(1)  199/       0 : =$5                  p2_touch_top_bit   = p1_touch_top_bit + 1
(1)  200/       0 :                     
(1)  201/       0 : =$10                 p1_touch_top       = 1<<p1_touch_top_bit
(1)  202/       0 : =$20                 p2_touch_top       = 1<<p2_touch_top_bit
(1)  203/       0 :                     
(1)  204/       0 : =$30                 touch_top_mask     = p1_touch_top|p2_touch_top
