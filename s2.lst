(1) 3786/    11F5 :                     
(1) 3787/    11F5 :                     ; Music IDs
(1) 3788/    11F5 :                     ; bank         - Which bank that the song is in.
(1) 3789/    11F5 :                     ; pal          - Whether the song should play slower on PAL consoles.
(1) 3790/    11F5 :                     ; uncompressed - Whether the song data is uncompressed or not.
(1) 3791/    11F5 :                     ; label        - The location of the song data's pointer.
(1) 3792/    11F5 :                     music_metadata macro bank,pal,uncompressed,label
(1) 3793/    11F5 :                         if bank
(1) 3794/    11F5 :                     .base = MusicPoint2
(1) 3795/    11F5 :                         else
(1) 3796/    11F5 :                     .base = MusicPoint1
(1) 3797/    11F5 :                         endif
(1) 3798/    11F5 :                     	db	(bank<<7)|(pal<<6)|(uncompressed<<5)|((label-.base)/2)
(1) 3799/    11F5 :                         endm
