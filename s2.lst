   18136/    DE19 :                     
   18137/    DE19 :                     	; Total height: 8 128x128 chunks.
   18138/    DE19 :                     	; CPZ's background is only 7 chunks tall, but extending to
   18139/    DE19 :                     	; 8 is necessary for wrapping to be achieved using bitmasks.
   18140/    DE19 :                     
