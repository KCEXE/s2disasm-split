   22260/   92F0E :                     
   22261/   92F0E :                     ; >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
   22262/   92F0E :                     ; LEVEL ART AND BLOCK MAPPINGS (16x16 and 128x128)
   22263/   92F0E :                     ;
   22264/   92F0E :                     ; #define BLOCK_TBL_LEN  // table length unknown
   22265/   92F0E :                     ; #define BIGBLOCK_TBL_LEN // table length unknown
   22266/   92F0E :                     ; typedef uint16_t uword
   22267/   92F0E :                     ;
   22268/   92F0E :                     ; struct blockMapElement {
   22269/   92F0E :                     ;  uword unk : 5;    // u
   22270/   92F0E :                     ;  uword patternIndex : 11; };  // i
   22271/   92F0E :                     ; // uuuu uiii iiii iiii
   22272/   92F0E :                     ;
   22273/   92F0E :                     ; blockMapElement (*blockMapTable)[BLOCK_TBL_LEN][4] = 0xFFFF9000
   22274/   92F0E :                     ;
   22275/   92F0E :                     ; struct bigBlockMapElement {
   22276/   92F0E :                     ;  uword : 4
   22277/   92F0E :                     ;  uword blockMapIndex : 12; };  //I
   22278/   92F0E :                     ; // 0000 IIII IIII IIII
   22279/   92F0E :                     ;
   22280/   92F0E :                     ; bigBlockMapElement (*bigBlockMapTable)[BIGBLOCK_TBL_LEN][64] = 0xFFFF0000
   22281/   92F0E :                     ;
   22282/   92F0E :                     ; /*
   22283/   92F0E :                     ; This data determines how the level blocks will be constructed graphically. There are
   22284/   92F0E :                     ; two kinds of block mappings: 16x16 and 128x128.
   22285/   92F0E :                     ;
   22286/   92F0E :                     ; 16x16 blocks are made up of four cells arranged in a square (thus, 16x16 pixels).
   22287/   92F0E :                     ; Two bytes are used to define each cell, so the block is 8 bytes long. It can be
   22288/   92F0E :                     ; represented by the bitmap blockMapElement, of which the members are:
   22289/   92F0E :                     ;
   22290/   92F0E :                     ; unk
   22291/   92F0E :                     ;  These bits have to do with pattern orientation. I do not know their exact
   22292/   92F0E :                     ;  meaning.
   22293/   92F0E :                     ; patternIndex
   22294/   92F0E :                     ;  The pattern's address divided by $20. Otherwise said: an index into the
   22295/   92F0E :                     ;  pattern array.
   22296/   92F0E :                     ;
   22297/   92F0E :                     ; Each mapping can be expressed as an array of four blockMapElements, while the
   22298/   92F0E :                     ; whole table is expressed as a two-dimensional array of blockMapElements (blockMapTable).
   22299/   92F0E :                     ; The maps are read in left-to-right, top-to-bottom order.
   22300/   92F0E :                     ;
   22301/   92F0E :                     ; 128x128 maps are basically lists of indices into blockMapTable. The levels are built
   22302/   92F0E :                     ; out of these "big blocks", rather than the "small" 16x16 blocks. bigBlockMapTable is,
   22303/   92F0E :                     ; predictably, the table of big block mappings.
   22304/   92F0E :                     ; Each big block is 8 16x16 blocks, or 16 cells, square. This produces a total of 16
   22305/   92F0E :                     ; blocks or 64 cells.
   22306/   92F0E :                     ; As noted earlier, each element of the table provides 'i' for blockMapTable[i][j].
   22307/   92F0E :                     ; */
   22308/   92F0E :                     
   22309/   92F0E :                     ; All of these are compressed in the Kosinski format.
   22310/   92F0E :                     
   22311/   92F0E :                     BM16_EHZ:	BINCLUDE	"mappings/16x16/EHZ.kos"
   22312/   93CBC :                     ArtKos_EHZ:	BINCLUDE	"art/kosinski/EHZ_HTZ.kos"
   22313/   9662A :                     BM16_HTZ:	BINCLUDE	"mappings/16x16/HTZ.kos"
   22314/   96B3A :                     ArtKos_HTZ:	BINCLUDE	"art/kosinski/HTZ_Supp.kos" ; HTZ pattern suppliment to EHZ level patterns
   22315/   97DBA :                     BM128_EHZ:	BINCLUDE	"mappings/128x128/EHZ_HTZ.kos"
   22316/   9AFFE :                     
   22317/   9AFFE :                     BM16_MTZ:	BINCLUDE	"mappings/16x16/MTZ.kos"
   22318/   9B668 :                     ArtKos_MTZ:	BINCLUDE	"art/kosinski/MTZ.kos"
   22319/   9CEE2 :                     BM128_MTZ:	BINCLUDE	"mappings/128x128/MTZ.kos"
   22320/   9E166 :                     
